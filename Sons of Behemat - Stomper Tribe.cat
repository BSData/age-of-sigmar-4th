          <selectionEntries>
            <selectionEntry name="Absolutely Fuming" id="a6d2-e141-1f3f-7a43" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
              <constraints>
                <constraint id="0b82-6adb-c048-0dab" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Absolutely Fuming" id="d71e-8860-b7dc-f96b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 2 to the Attacks characteristic of this unit&apos;s **Almighty Stomp** if it did not use a **^^Fight^^** ability in the previous turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Eager for the Fight" id="0621-e509-0df5-637b" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
              <constraints>
                <constraint id="2ac7-a85d-b072-2e15" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Eager for the Fight" id="51fa-4470-8b06-6e9b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
