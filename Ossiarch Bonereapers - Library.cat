            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Start of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit can only use this ability if at least half the units from your starting army have been destroyed.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle round:
• Add 5 to the Attacks characteristic of this unit&apos;s **Inda-Khaat**.
• Add 3 to the Attacks characteristic of this unit&apos;s **The Shield Immortis**.
• This unit cannot use the &apos;Supreme Lord of the Bonereaper Legions&apos; ability.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Supreme Lord of the Bonereaper Legions" id="ec-6c0b-673c-88ee" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
