            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Spell-chomper" hidden="false" id="a8fd-473a-0eb2-5f83" publicationId="b765-4747-cddc-385e">
              <profiles>
                <profile name="Spell-chomper" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="8730-3316-54dc-5c7b">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit can use **^^Unbind^^** and **^^Banish^^** abilities as if it had **^^Wizard (1)^^**. In addition, each time an enemy **^^Manifestation^^** within this unit&apos;s combat range is banished, **Heal (D3)** this unit.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="7a49-c857-fe9b-8c5f" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Always First In" hidden="false" id="6bac-0e5c-a65f-1987" publicationId="b765-4747-cddc-385e">
              <profiles>
                <profile name="Always First In" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="8b97-4938-028e-4a4b">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can move 2D6&quot;. It must end that move more than 9&quot; from all enemy units.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
