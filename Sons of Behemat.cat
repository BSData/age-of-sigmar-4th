    <selectionEntryGroup name="Battle Formations: Sons of Behemat" id="4e00-4aeb-ae2-c3d5" hidden="false" flatten="true">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Looting Leviathans" hidden="false" id="bd2d-ab85-0882-2b6c" publicationId="b765-4747-cddc-385e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bfab-8563-198d-f15f"/>
          </constraints>
          <profiles>
            <profile name="Get to the Goods" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="35e4-bd58-4850-66dd">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a friendly **^^Big^^** or **^^Little^^** unit that charged in the same turn makes a pile-in move, that unit can pass across enemy models in non-**^^Monster^^** units.</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Conquering Stomp" hidden="false" id="c2c7-4909-81d3-f2ed" publicationId="b765-4747-cddc-385e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="01e6-a962-dfa9-750f"/>
          </constraints>
          <profiles>
            <profile name="Arrogant Big &apos;Uns" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="9ad1-85ec-96a6-70ed">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In the first battle round, subtract 1 from hit rolls for combat attacks that target friendly **^^Big^^** and **^^Little^^** units that have not charged in the same turn.</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Eager Louts" hidden="false" id="8109-67a6-3b1e-f903" publicationId="b765-4747-cddc-385e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="82b1-f59a-4971-0517"/>
          </constraints>
          <profiles>
            <profile name="Ten-League Strides" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="683f-9b72-7a67-d598">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a friendly **^^Big^^** or **^^Little^^** unit uses the &apos;Redeploy&apos; command or the &apos;Run&apos; ability, if you roll a 1-2 when determining the distance that unit can move, you can use a value of 3 instead.</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Heirs of the Old Ways" hidden="false" id="642b-d956-3822-53cc" publicationId="b765-4747-cddc-385e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7260-6e63-540e-e9b6"/>
          </constraints>
          <profiles>
            <profile name="Brute Spirituality" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="a67d-d1e0-b8b4-4d43">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Big^^** or **^^Little^^** unit to use this ability, then pick an enemy **^^Wizard^^** or **^^Priest^^** within 18&quot; of it to be the target.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make a rampage roll of D6. If the roll equals or exceeds the target&apos;s Control characteristic:
• The target has a maximum power level of 1 until the start of your next turn.
• All **^^Manifestations^^** that were summoned by the target are banished and removed from play.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Manskittle Mob" hidden="true" id="342d-444a-227c-34c3" publicationId="f894-7929-f79a-a269">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="af3d-9d69-757a-41bf"/>
          </constraints>
          <profiles>
            <profile name="Strike! Hur Hur!" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="0bef-d9b8-8fe4-f030">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 2 friendly **^^Mega-Gargant^^** units within 3&quot; of any terrain features and pick any friendly **^^Gargant^^** units within 3&quot; of any terrain features to be the targets.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Double the Attacks characteristic of each target&apos;s ranged weapons for the rest of the turn. If the target has no ranged weapons, pick an enemy unit within 12&quot; of the target instead and roll a D3. On a 2+, inflict an amount of mortal damage on that enemy unit equal to the roll.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Big Toes" hidden="true" id="e7ee-a697-4858-15f4" publicationId="f894-7929-f79a-a269">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4d81-e460-1f05-80a9"/>
          </constraints>
          <profiles>
            <profile name="Lofty Louts" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="6ae1-01a3-e57f-ee51">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4"/>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **Mancrusher Gargant** unit to be the target.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle, add 1 to hit rolls for combat attacks made by friendly **^^Gargant^^** units while they are wholly within 12&quot; of the target and not wholly within 12&quot; of any friendly **^^Mega-Gargant^^** units.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
