            <selectionEntry type="upgrade" import="true" name="Hammer Throw" hidden="false" id="6c7f-1d37-619d-6b1f" publicationId="b765-4747-cddc-385e">
              <profiles>
                <profile name="Hammer Throw" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="63b8-346b-6f8d-5bad">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit is not in combat, pick a friendly **Mancrusher Gargant** within its combat range to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll 3D6. On a 4+, remove the target from the battlefield and set it up again wholly within a number of inches of this unit equal to the roll and visible to this unit. It can be set up in combat. The target cannot use **^^Charge^^** abilities for the rest of the turn.

If the target is set up in combat:
• Inflict D3 mortal damage on the target.
• Inflict 1 mortal damage on each enemy unit in combat with the target.
• The target has charged this turn.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Core^^**, **^^Attack^^**, **^^Shoot^^**, **^^Rampage^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="317c-6adb-0360-5907" includeChildSelections="true"/>
              </constraints>
