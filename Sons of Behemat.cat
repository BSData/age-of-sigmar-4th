                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="e0a9-cd2b-3d4f-ab50" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Thundering Titan" hidden="false" id="71b7-b476-ddeb-eef1" publicationId="b765-4747-cddc-385e">
              <profiles>
                <profile name="Thundering Titan" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="d0c1-25b2-d3e1-ec10">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this turn, pick a non-**^^Hero^^** enemy unit in combat with it to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make a rampage roll of D6. If the roll equals or exceeds the target&apos;s Control characteristic, this unit cannot be picked to be the target of pile-in moves made by the target while there are other friendly **^^Sons of Behemat^^** units in combat with the target.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="b122-af33-76dc-f435" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="One-hit Wonder" hidden="false" id="4943-a3a3-e6f2-4a8c" publicationId="b765-4747-cddc-385e">
              <profiles>
                <profile name="One-hit Wonder" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="d7a6-6ecd-c839-9c91">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Any Combat Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can make a pile-in move. Then, roll a dice. Add 1 to the roll for each battle round in which this unit was on the battlefield in both combat phases and did not use any **^^Fight^^** abilities. On a 6+, inflict 4D6 mortal damage on the target.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Core^^**, **^^Attack^^**, **^^Fight^^**, **^^Rampage^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="acee-9bb4-20bb-3546" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
          </selectionEntries>
