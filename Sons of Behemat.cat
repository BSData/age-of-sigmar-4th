              <profiles>
                <profile name="Always On Guard" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="64c4-efa8-6801-3d6e">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit has Ward (5+) while it is wholly within 12&quot; of and visible to a friendly Mega-Gargant.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Green</attribute>
