                <profile name="Colossal Slam" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="678c-dd9b-9e8b-9bc1">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy **^^Monster^^** or **^^War Machine^^** that has no more than 1 model and is in combat with this unit to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If 2 or more friendly **^^Big^^** or **^^Little^^** units are in combat with the target, apply the effect below. Otherwise, make a rampage roll of D6. Subtract 1 from the roll if the target has a higher Health characteristic than this unit. On a 3+, apply the effect below.

Remove the target from the battlefield and set it up again in combat with this unit. Then, inflict D3 mortal damage on the target.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
