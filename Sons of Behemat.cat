              <profiles>
                <profile name="Brute of Brutes" id="0697-a953-d7d3-cd37" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
