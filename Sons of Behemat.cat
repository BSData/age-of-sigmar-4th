                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Unreasonable Tyrant" id="4c0c-553b-6b57-11d1" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
              <constraints>
                <constraint id="e0a9-cd2b-3d4f-ab50" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Unreasonable Tyrant" id="c553-a4aa-ecd4-678e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick another visible friendly **^^Sons of Behemat Monster^^** unit wholly within 12&quot; of this unit to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to charge rolls for the target for the rest of the turn.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Thundering Titan" id="71b7-b476-ddeb-eef1" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
              <constraints>
                <constraint id="b122-af33-76dc-f435" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Thundering Titan" id="d0c1-25b2-d3e1-ec10" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this turn, pick a non-**^^Hero^^** enemy unit in combat with it to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Make a rampage roll of D6. If the roll equals or exceeds the target&apos;s Control characteristic, this unit cannot be picked to be the target of pile-in moves made by the target while there are other friendly **^^Sons of Behemat^^** units in combat with the target.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="One-hit Wonder" id="4943-a3a3-e6f2-4a8c" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
              <constraints>
                <constraint id="acee-9bb4-20bb-3546" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
