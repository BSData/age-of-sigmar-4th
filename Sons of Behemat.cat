                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit can use **^^Unbind^^** and **^^Banish^^** abilities as if it had **^^Wizard (1)^^**. In addition, each time an enemy **^^Manifestation^^** within this unit&apos;s combat range is banished, **Heal (D3)** this unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Always First In" id="6bac-0e5c-a65f-1987" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
