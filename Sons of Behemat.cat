              <profiles>
                <profile name="Brute of Brutes" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="0697-a953-d7d3-cd37">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignore negative modifiers to hit rolls and wound rolls for this unit&apos;s combat attacks.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
