          </modifiers>
          <rules>
            <rule name="Enhancement Restrictions" id="30bd-be15-fa94-a24f" hidden="true">
              <description>Cracked Heels are unique enhancements that can be given to **^^Mancrusher Gargants^^**. A unit can only have 1 Cracked Heel.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="That Boy&apos;s Not Right" id="0617-416a-104b-9b43" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="73ef-ec1c-a2d8-fc29" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
