                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="d200-a5df-bcf9-2d23" includeChildSelections="true"/>
              </constraints>
                          <modifiers>
                <modifier type="set" value="0" field="points">
                  <conditionGroups>
                    <conditionGroup type="or">
