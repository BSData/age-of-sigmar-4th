                <profile name="Rancid Flatulence" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="c92c-fc4e-2609-86b5">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), End of Any Turn</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, enemy units have a maximum control score of 1 while they are in combat with this unit.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic>
