  <sharedSelectionEntries>
    <selectionEntry name="Battle Traits: Barrow Legion" id="bd82-8424-ed1b-1373" hidden="false" import="true" publicationId="e3a0-cfae-cbb3-0215" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="c7c7-2932-3085-4595" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="All to Dust" id="10e6-f36d-ff98-6686" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">In the third and subsequent battle rounds, while a friendly **Cursed Sepulchre** is on the battlefield, subtract 1 from save rolls for enemy units.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Royal Crypt" id="6571-97d9-bc62-f950" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Deployment Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This ability must be used instead of the &apos;Deploy Faction Terrain Feature&apos; ability.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up 3 **Cursed Sepulchres** wholly within friendly territory, each within 1/2&quot; of any of the others and more than 3&quot; from all objectives and other terrain features. After you have done so, they have been deployed and they are considered to be a single **Cursed Sepulchre** terrain feature that has a Health characteristic of 24 instead of 8.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy Terrain^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Gifts to the Petty Kingdoms" id="ec89-8708-1461-c669" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Deployment Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 2 friendly non-**^^Unique Barrow Legion Heroes^^** that do not have an artefact of power to be the targets (you can pick units in reserve).</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Give each target 1 artefact of power from the &apos;Barrow Legion&apos; Army of Renown rules.
**Designer&apos;s Note:** *These artefacts of power are give to the* **^^Heroes^^** *during the deployment phase, not during list construction.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Endless Legions of Bone" id="b2b0-890e-55bb-2034" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round (Army), Any Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly non **^^Unique Barrow Legion^^** that has been destroyed to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up a replacement unit with half the number of models from the target unit (rounding up) wholly within 12&quot; of a friendly **^^Barrow Legion Hero^^** or wholly within 6&quot; of a friendly **Cursed Sepulchre**. It must be set up more than 9&quot; from all enemy units.
If it is your movement phase, you can set up the replacement unit more than 3&quot; from all enemy units instead of more than 9&quot;, but if you set it up within 9&quot; of any enemy units, it cannot use **^^Charge^^** abilities this turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Grave Sentinels" id="2225-77c1-05c7-77f9" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">The melee weapons used by friendly **^^Barrow Legion^^** units have **Anti-charge (+1 Rend)** while they are wholly within 9&quot; of a friendly **Cursed Sepulchre**.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
