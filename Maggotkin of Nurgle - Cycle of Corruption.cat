  <sharedSelectionEntries>
    <selectionEntry name="Battle Traits: Cycle of Corruption" id="0c6e-a19c-24a0-ad24" hidden="false" import="true" publicationId="9c71-86cb-e1d0-ec8d" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="57f6-5ee9-ea10-8a7d" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Revolution and Revulsion" id="d8de-0c88-4cd6-0246" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round (Army), Start of Battle Round</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You must use this ability at the start of each battle round.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If it is the first battle round, roll a dice to determine which **^^Cycle^^** ability is ripe for the rest of the battle round.
**1** &apos;Unnatural Fecundity&apos;
**2** &apos;Fecund Vigour&apos;
**3** &apos;Burgeoning Filth&apos;
**4** &apos;Plague of Misery&apos;
**5** &apos;Nauseous Revulsion&apos;
**6** &apos;Rampant Disease&apos;
**7** &apos;Corrupted Regrowth&apos;
If it is not the first battle round, the next **^^Cycle^^** ability in the sequence is ripe for the rest of the battle round. If the &apos;Corrupted Regrowth&apos; ability was ripe last battle round, the &apos;Unnatural Vitality&apos; ability is ripe this battle round.
You can only use a **^^Cycle^^** ability if it is ripe. Only 1 **^^Cycle^^** ability is ripe each battle round.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Unnatural Vitality" id="0ae9-e499-ce65-4514" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Cycle^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Friendly non-^^**Monster Cycle of Corruption Heroes^^** have **^^Ward (4+)^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fecund Vigour" id="4026-ad96-aea1-3e35" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** each friendly **^^Cycle of Corruption^^** unit.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Cycle^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Burgeoning Filth" id="24a8-a39a-779a-0706" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Cycle^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Subtract 3 from the control scores of enemy units wihle they are in combat with any friendly **^^Cycle of Corruption^^** units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Plague of Misery" id="dc86-02a9-67e0-9e23" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Cycle^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While enemy units are within 12&quot; of any friendly &apos;Cycle of Corruption&apos; units, they cannot use abilities that heal or return slain models to a unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Nauseous Revulsion" id="fbe4-c3d7-baf3-73d8" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Cycle^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Subtract 1 from charge rolls for enemy units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rampant Disease" id="2883-6bf7-f021-990c" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Cycle^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Melee weapons used by friendly non-**^^Hero Cycle of Corruption^^** units have **Crit (2 Hits)**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Corrupted Regrowth" id="894a-c91e-c8ab-3f5a" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (7)** each friendly **Feculent Gnarlmaw**.
If there are no friendly **Feculent Gnarlmaws** on the battlefield, you can set up a **Feculent Gnarlmaw** on the battlefield more than 9&quot; from all enemy units and more than 3&quot; from all objectives and other terrain features.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Cycle^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
