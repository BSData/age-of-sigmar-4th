            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="The Last Blade of Embergard" id="58c1-61c4-2be2-cf30" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7c66-6d5f-823-57f4" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <profiles>
                <profile name="The Last Blade of Embergard" id="96b7-38d0-c137-856" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Deployment Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can use this ability while it is in reserve. Pick 1 of this unit&apos;s non-**Companion** melee weapons. Add 2 to that weapon&apos;s Attacks characteristic and Rend characteristic for the rest of the battle.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Bones of Saint Ignifus" id="98dc-9f8e-95e1-fc8e" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a79e-82e8-960-8755" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Bones of Saint Ignifus" id="ff-fea1-9cae-7fdf" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Spell^^** or **^^Prayer^^** ability for a visible unit that is wholly within 12&quot; of this unit and **under orders**</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to the casting roll or chanting roll for that ability.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="The Sphere Celestial" id="c244-fb99-a193-4a8d" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6ca7-a3fe-87fb-8fcb" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="0"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="The Sphere Celestial" id="d4cf-cc63-c61c-4f4d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit is not in combat, pick a point on the battlefield within 1&quot; of this unit and more than 3&quot; from all other units (friendly and enemy) and terrain features to be the target point. Then, pick another visible friendly **^^Cities of Sigmar Infantry^^** or ^^**Cavalry Hero^^** that is wholly within 18&quot; of this unit and not in combat to be the target unit.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Remove this unit from the battlefield and set it up again within 1&quot; of the target unit and not in combat. Then, remove the target from the battlefield and set it up again within 1&quot; of the target point and not in combat. This unit and the target unit can use **^^Move^^** abilities in the following movement phase (this is an exception to Core Rules, 24.0).</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntryGroup>
    <selectionEntryGroup name="Battle Formations: Cities of Sigmar" id="bb8f-ca64-b083-4c7b" flatten="true" hidden="false">
      <constraints>
        <constraint id="30fd-77cb-aa65-bbb4" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Stalwart Guardians" id="a769-683a-19c8-5f98" hidden="false" import="true" publicationId="a746-732d-1a22-460" type="upgrade">
          <constraints>
            <constraint id="e165-684-2253-9673" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="To the Last" id="b49a-35fc-1cf5-7848" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a friendly unit that is **under orders** uses the &apos;Rally&apos; command, you can make 3 additional rally rolls of D6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Collegiate Exemplars" id="225e-a217-d55-2cb0" hidden="false" import="true" publicationId="a746-732d-1a22-460" type="upgrade">
          <constraints>
            <constraint id="454b-b9bd-5593-11f0" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Masters of the Arcane" id="df89-8c5c-57fa-fd29" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to arcane manipulation rolls and banishment rolls for friendly **^^Wizards^^** that are **under orders**.
**Designer&apos;s Note:** *Wizards in this battletome use arcane manipulation rolls for a variety of powerful effects.*</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Zealous Hordes" id="9cd5-6e01-a51e-4b41" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4ab6-3bb3-274f-210e" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Throngs of the Faithful" id="f184-caa1-5d57-f9be" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Reaction: Your opponent declared a **^^Fight^^** ability.</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, add 1 to wound rolls for combat attacks made by friendly **^^Sigmarite^^** units that target the enemy unit using that **^^Fight^^** ability.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Swift Reinforcements" id="7022-54db-fb73-5d95" hidden="false" import="true" publicationId="a746-732d-1a22-460" type="upgrade">
          <constraints>
            <constraint id="9bcd-9628-36a2-a090" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Dawnbringer Crusade" id="f462-cd42-adfd-a4ac" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly non-**^^Hero Cities of Sigmar Infantry^^** unit wholly within friendly territory to use this ability.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If that unit is in combat, it can move 6&quot;. It can move through the combat ranges of enemy units but can only end that move in combat with units it was in combat with at the start of the move. It does not have to end the move in combat.
If that unit is not in combat, it can move 6&quot;. It cannot move into combat during any part of that move.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Move^^**</characteristic>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Veteran Cannoneers" id="a574-28e2-35a2-5378" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
          <constraints>
            <constraint id="9780-c139-0ee6-1bfd" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="0"/>
