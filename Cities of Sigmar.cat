                    <condition childId="1bed-ddb5-0c50-16d2" field="selections" includeChildSelections="true" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="01b1-5112-ab45-1afc" field="selections" includeChildSelections="true" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="f079-501a-2738-6844" field="selections" includeChildSelections="true" scope="ancestor" shared="true" type="instanceOf" value="1"/>
