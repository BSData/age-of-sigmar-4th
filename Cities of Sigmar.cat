              <profiles>
                <profile name="Cosmopolitan Leader" id="94a8-f024-6476-93ae" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Cities of Sigmar Infantry^^** or **^^Cavalry^^** unit wholly within 12&quot; of this unit to be the target. If this unit is **^^Human^^**, pick up to 3 eligible units to be the targets instead.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, until the start of your next turn:
• If the target is **^^Human^^**, add 1 to wound rolls for the target&apos;s combat attacks.
• If the target is **^^Duardin^^**, add 1 to charge rolls for the target.
• If the target is **^^Aelf^^**, add 3 to the target&apos;s control score.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
