            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Bashful Visage" id="81c4-3e8a-e7ac-5413" hidden="false" import="true" publicationId="95fc-e96f-a916-bba1" type="upgrade">
              <constraints>
                <constraint id="35b7-c906-49df-edd3" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Bashful Visage" id="4838-b034-28ab-378b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While they are wholly within 6&quot; of this unit, friendly non-**^^Monster^^** non-**^^War Machine Hedonites of Slaanesh^^** units are not visible to enemy units more than 12&quot; from them.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="The Rod Of Misrule" id="8b0b-791a-7873-1a61" hidden="false" import="true" publicationId="95fc-e96f-a916-bba1" type="upgrade">
              <constraints>
                <constraint id="53c8-d59c-5a97-eeeb" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="0"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <modifiers>
                <modifier field="points" type="set" value="0">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="1bed-ddb5-0c50-16d2" field="selections" includeChildSelections="true" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                        <condition childId="01b1-5112-ab45-1afc" field="selections" includeChildSelections="true" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                        <condition childId="f079-501a-2738-6844" field="selections" includeChildSelections="true" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="The Rod Of Misrule" id="1e95-1a75-154b-6d17" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick another visible friendly **^^Hedonites of Slaanesh^^** unit wholly within 12&quot; of this unit to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, when the target uses the &apos;Power Through&apos; command, you can pick an enemy target for that command that does not have a lower Health characteristic than the unit using that command.</characteristic>
