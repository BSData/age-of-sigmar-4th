                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">The first time each turn that an unmodified charge roll, casting roll, unbinding roll or banishment roll for a friendly non-**^^Euphoric^^** unit wholly within 12&quot; of this unit is 5 or less, that unit has the **^^Euphoric^^** keyword for the rest of the turn.</characteristic>
                  </characteristics>
                </profile>
