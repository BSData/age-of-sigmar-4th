                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Enemy Hero Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You can only use this ability if your opponent has any temptation dice. Pick a visible enemy unit within 18&quot; of this unit to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, while your opponent has not used any of their temptation dice to replace a roll for the target this turn, the target can only use **^^Core^^** abilities.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Celebrity Warlord" id="a759-a125-4840-f353" hidden="false" import="true" type="upgrade">
