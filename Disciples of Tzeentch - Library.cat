            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While they are wholly within 12&quot; of this unit, friendly **^^Disciples of Tzeentch^^** units can use the &apos;Redeploy&apos; command even if they were set up in the same turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Whispers of Treachery" id="1b63-b0b4-f62b-d5be" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
