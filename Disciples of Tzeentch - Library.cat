        <profile name="Lunatic Demise" id="3d6c-2e8b-dd95-ce35" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a model in this unit is slain, before removing the model from play, pick 1 of the following effects: 
***Split:*** Pick a friendly **Blue Horrors and Brimstone Horrors** unit within 12&quot; of this unit. Return up to 2 slain **Blue Horror** models to that unit. 
***Petty Vengeance:*** Pick an enemy unit in combat with this unit to be the target, then roll a dice. On a 5+, inflict 1 mortal damage on the target.</characteristic>
          </characteristics>
        </profile>
      </profiles>
