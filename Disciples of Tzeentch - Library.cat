                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While you have 3 or more **fate points**, add 1 to hit rolls for this unit&apos;s attacks.
While you have 6 or more **fate points**, add 1 to wound rolls for this unit&apos;s attacks.
While you have 9 or more **fate points**, add 1 to the Rend characteristic of this unit&apos;s melee weapons.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
