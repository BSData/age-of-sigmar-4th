  <sharedSelectionEntries>
    <selectionEntry name="Battle Traits: Taar&apos;s Grand Forgehost" id="6d9c-100e-1ab4-82da" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="a3b8-c20d-5d18-9e0f" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Rising Fire" id="90ab-eea7-9e51-2e9a" hidden="false" publicationId="487d-9798-0633-8040" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">The following cumulative effects apply to friendly **^^Grand Forgehost^^** units in each battle round after the first.
**Battle Round 2:**
***Daemonic Weaponry:*** Those units&apos; weapons have **Crit (2 Hits)**.
**Battle Round 3:**
***Harnessed Sorcery:*** Add 1 to casting rolls and chanting rolls for those units.
**Battle Round 4:**
***Channeled Power:*** Attacks made by those units score critical hits on unmodified hit rolls of 5+.
**Battle Round 5:**
***Arcane Dominance:*** Add 1 to the power level of those units if they are a **^^Wizard^^** or **^^Priest^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Dread Ranks Unbroken" id="e0fe-7fba-e64f-8c9c" hidden="false" publicationId="487d-9798-0633-8040" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Grey</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Once Per Turn (Army), Your Movement Phase</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Pick a friendly non-**^^Hero Grand Forgehost Infantry^^** unit that has been destroyed to be the target.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Set up a replacement unit with half the number of models from the target unit (rounding up) wholly within 6&quot; of the battlefield edge and more than 9&quot; from all enemy units.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Skilled Skirmishers" id="ec6a-c186-9c8d-f27d" hidden="false" publicationId="487d-9798-0633-8040" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Friendly **^^Grand Forgehost War Machines^^** have **^^Ward (6+)^^**.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
