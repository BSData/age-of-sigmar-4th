                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">When making run rolls for friendly units wholly within 12&quot; of this unit, if you roll a 1-3, you can use a value of 4 instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
