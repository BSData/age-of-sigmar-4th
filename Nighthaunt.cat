                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Your Movement Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If there are fewer than 3 friendly **Nexuses of Grief** on the battlefield, set up a **Nexus of Grief** within 3&quot; of a friendly **^^Nighthaunt^^** unit, more than 3&quot; from all objectives and enemy units, more than 1&quot; from all other terrain features, and more than 12&quot; from all other friendly **Nexuses of Grief**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
