  <sharedSelectionEntries>
    <selectionEntry name="Battle Traits: Nighthaunt" id="53c5-1078-24f5-3301" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="389c-d92-bf1f-30e5" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Ethereal" id="ca03-ec11-f370-b66d" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignore negative modifiers to save rolls for friendly **^^Nighthaunt^^** units, excluding **Nagash**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ethereal Translocation" id="c6d2-2b92-5367-7b43" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Grey</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Movement</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Once Per Turn (Army), Your Movement Phase</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Pick a friendly **^^Nighthaunt^^** unit that is not in combat to use this ability.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Remove that unit from the battlefield and set it up again on the battlefield more than 9&quot; from all enemy units.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Mounting Dread" id="fc5b-13e9-6116-364b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Subtract the current battle round number from the control scores of enemy units while they are in combat with any friendly **^^Nighthaunt^^** units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sepulchral Apparitions" id="67e0-33db-1c0a-6797" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Deployment Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If there is a friendly **Nexus of Grief** on the battlefield, you can set up up to 2 additional **Nexuses of Grief** on the battlefield. Each must be set up wholly outside enemy territory, more than 3&quot; from all objectives and other terrain features, and more than 12&quot; from all other friendly **Nexuses of Grief**.
**Designer&apos;s Note:** *The original* **Nexus of Grief** *is set up in Step 1 of the deployment phase using the &apos;Deploy Faction Terrain&apos; ability. This ability allows you to set up a second and third such terrain feature and is used in Step 3 of the deployment phase, after armies have been deployed.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
