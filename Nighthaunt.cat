                <profile name="Urn of Despondency" id="04f0-d275-ecd9-b826" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
