        <profile name="I&apos;m Watching You" id="47d1-3479-743a-e0aa" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Give this unit D3 **vexed points**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Alright, Listen Up" id="66b1-eba9-cb4a-4c9b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit is wholly within 12&quot; of a friendly non-**^^Hero Kharadron Overlords^^** unit, pick a visible enemy unit wholly within 18&quot; of this unit to be the target. Then, choose to spend either 3 or 6 **vexed points**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 of the following effects to apply to the target for the rest of the turn:
• ***Do you see how fast they are going?!:*** If you spent 3 **vexed points**, subtract D3 from the target&apos;s Move characteristic. If you spent 6 **vexed points**, halve the target&apos;s Move characteristic.
• ***Those weapons are against regulation!:*** If you spent 3 **vexed points**, subtract 1 from wound rolls for the target&apos;s combat attacks. If you spent 6 **vexed points**, subtract 1 from the Rend characteristic of the target&apos;s melee weapons and subtract 1 from wound rolls for the target&apos;s combat attacks.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
