                </characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hungering Warherd" id="ce64-e8cd-1689-d0ea" hidden="false" import="true" publicationId="3cc2-31d3-9dd2-f858" type="upgrade">
          <constraints>
