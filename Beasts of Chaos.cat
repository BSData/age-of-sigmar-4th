          </constraints>
          <profiles>
            <profile name="Bloodgreed" id="6e4d-7865-37cb-bd15" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
