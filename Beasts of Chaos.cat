        <selectionEntry name="Thunderscorn Stormherd" id="2fe8-224b-0326-c58a" hidden="false" import="true" publicationId="3cc2-31d3-9dd2-f858" type="upgrade">
          <constraints>
            <constraint id="a4b2-5b9b-180e-f66f" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Raging Storm" id="4a45-bfc6-e244-5c5f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each friendly **^^Thunderscorn^^** unit on the battlefield to be the friendly targets, then pick each enemy unit in combat with any friendly **^^Thunderscorn^^** units to be the enemy targets.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (1)** each friendly target. Then, roll a D3 for each enemy target, if any. On a 2+, inflict an amount of mortal damage on the enemy target equal to the roll.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
