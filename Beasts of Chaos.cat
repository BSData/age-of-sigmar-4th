                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn, Reaction: Opponent declared a **^^Shoot^^** ability that targeted a friendly **^^Beasts of Chaos^^** unit</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If that friendly **^^Beasts of Chaos^^** unit is not in combat and is wholly within 18&quot; of this unit, after the **^^Shoot^^** ability has been resolved, that friendly unit can move 2D6&quot;. It can move into combat.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
