  <sharedSelectionEntries>
    <selectionEntry name="Battle Traits: Throngankor Alliance" id="1655-87cd-1b21-c6be" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="c1dc-0307-b0ce-1cec" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Stone and Sky" id="016d-c594-1d89-aefa" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Start of Battle Round</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly non-**^^Hero Khazalite Holds Infantry^^** unit and a friendly non-**^^Hero Kharadron Overlords Infantry^^** unit that are within ½&quot; of each other to be the targets.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle round, while the targets are within ½&quot; of each other:
• The targets have the **^^Stone and Sky^^** keyword.
• Subtract 1 from wound rolls for attacks that target those friendly units.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Duardin Pride" id="1cf1-10ce-a628-2701" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 10 to the control scores of friendly **^^Throngankor Alliance^^** units while they are wholly within 12&quot; of and visible to any friendly **^^Stone and Sky^^** units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hammer and Anvil" id="b18d-1ff4-3c71-e88c" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Shooting Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly non-**^^Stone and Sky Throngankor Alliance^^** unit that is in combat to be the anvil. Then, pick an enemy unit in combat with the anvil to be the workpiece. Finally, pick a friendly **^^Throngankor Alliance^^** unit that is not in combat and does not have the same faction keyword (i.e. **^^Khazalite Holds^^** or **^^Kharadron Overlords^^**) as the anvil to be the hammer.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, the hammer&apos;s ranged weapons have Crit (2 Hits) for shooting attacks that target the workpiece.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Transport Duardin" id="6ff4-016d-7e08-cf3f" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Reaction: You declared a **^^Move^^** ability for a friendly **^^Skyvessel^^** in your movement phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a number of **^^Throngankor Alliance Infantry^^** units up to that **^^Skyvessel^^**&apos;s Transport Capacity (see its warscroll) that are wholly within 6&quot; of it, visible to it and not in combat to be the targets. Units that have been transported this turn cannot be targets.
Remove the targets from the battlefield. After the **^^Skyvessel^^** ends its move, you must set up each target unit on the battlefield, wholly within 6&quot; of that **^^Skyvessel^^** and not in combat. Those units have been transported. A unit cannot use **^^Charge^^** abilities if it was transported in the same turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="The Vice" id="f04f-36d5-1667-6925" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly non-**^^Stone and Sky Khazalite Holds^^** unit and a friendly non-**^^Stone and Sky Kharadron Overlords^^** unit that are in combat with the same enemy unit to be the friendly targets. Then, pick an enemy unit in combat with both friendly targets to be the enemy target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, the friendly targets&apos; melee weapons have Crit (Mortal) for combat attacks that target the enemy target.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Allied Grudgement" id="dffb-d7ea-205a-4b4b" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle Round (Army), Reaction: Opponent declared a command for a unit within 12&quot; of and visible to a **^^Stone and Sky^^** unit in your army</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a friendly **^^Throngankor Alliance^^** unit and give it 1 grudge mark.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
