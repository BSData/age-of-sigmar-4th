            <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
            <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a visible enemy unit within 12&quot; of this unit to be the target, then make a chanting roll of D6.</characteristic>
            <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Subtract twice the current battle round number from the target&apos;s control score for the rest of the turn. If the chanting roll was 10+, this ability affects all enemy units within 12&quot; of this unit.</characteristic>
            <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d"/>
          </characteristics>
        </profile>
