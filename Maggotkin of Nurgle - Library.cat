                  </constraints>
                  <profiles>
                    <profile name="Risen from Disease" id="d923-2a85-bcc3-c8fc" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, End of Your Turn</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit can only use this ability if it has been destroyed. Pick this unit to be the target, then pick a **^^Diseased^^** enemy **^^Hero^^** to be the incubator.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You and your opponent must roll off. Add the target&apos;s Control characteristic to your roll and add the intubator&apos;s Control characteristic to your opponent&apos;s roll. If your roll equals or exceeds your opponent&apos;s, set up a replacement unit for the target with 4 damage points allocated to it within 3&quot; of the incubator. Then, if your roll is at least double your opponent&apos;s, the incubator is automatically destroyed.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
