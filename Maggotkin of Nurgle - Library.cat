      <profiles>
        <profile name="Battle Damaged" id="dfcb-be8b-6baf-8d54" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
