          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit&apos;s **Pestilent Pollutants** are tokens. This unit has 2 **Pestilent Pollutants**. Pick an objective or terrain feature within 12&quot; of this unit to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Place 2 of this unit&apos;s **Pestilent Pollutants** next to the target. If both of this unit&apos;s **Pestilent Pollutants** are already on the battlefield, pick 1 of them, remove it from the battlefield and place it next to the target instead.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="From the Tainted Earth" id="db42-b099-38fd-0d85" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Remove this unit from the battlefield and set it up again more than 9&quot; from all enemy units and wholly within 3&quot; of:
• An objective or terrain feature that has a friendly **Pestilent Pollutant**, or
• A **^^Polluted^^** terrain feature (see Gelgus Pust&apos;s &apos;Master Contaminator&apos; ability), or
• An objective you control</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Core^^**, **^^Move^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Entropy Endures" id="3b04-d902-db70-f233" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
