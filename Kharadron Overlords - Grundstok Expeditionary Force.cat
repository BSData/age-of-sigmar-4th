      <profiles>
        <profile name="Gun Butt Low Blow" id="216f-9e02-bf9b-0fa7" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
