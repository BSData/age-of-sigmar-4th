            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" id="1d6-6075-f32c-efd" hidden="false" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic>
            <characteristic name="Declare" id="f752-dc97-8be-f5b" hidden="false" typeId="bad3-f9c5-ba46-18cb">Pick 1 friendly unit in this Regiment of Renown that is not in combat to be the target.</characteristic>
            <characteristic name="Effect" id="4de9-dbd7-5177-168b" hidden="false" typeId="b6f1-ba36-6cd-3b03">Remove that unit from the battlefield and set it up again more than 6&quot; from all enemy units.</characteristic>
