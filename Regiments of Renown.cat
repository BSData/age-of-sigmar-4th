  <sharedSelectionEntries>
    <selectionEntry name="Regiment of Renown: The Liche&apos;s Hand" id="d63f-7194-a3af-7a00" defaultAmount="0" hidden="true" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="be73-c15d-207c-2246" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="3287-c571-e12d-ef2" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="9136-a422-571c-c77c" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Skeletal Splintering" id="473c-ac82-5506-6548" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">8</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">This spell can be cast by the same **^^Wizard^^** more than once per phase. Pick the **Arkhan the Black** in this Regiment of Renown to cast this spell, pick a visible enemy unit within 18&quot; of them that has not been picked to be the target of this spell this turn to be the target, then make a casting roll of 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Roll a number of dice equal to the number of models in the target unit. For each 5+, inflict 1 mortal damage on that unit.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Unholy Sacraments" id="e4dc-f3d4-388-7fb8" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the number of dice rolled when making banishment rolls for the **Arkhan the Black** in this Regiment of Renown, to a maximum of 3.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regiment of Renown: Neferata&apos;s Royal Echelon" id="b0be-ce3a-82e7-83d0" defaultAmount="0" hidden="true" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="498a-740-2a59-6179" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="d688-2a7c-1153-bfa9" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="e071-126a-fb3e-1462" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Soulpike" id="12aa-3a8f-f201-1b23" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick the **Neferata** in this Regiment of Renown to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, each time the target uses a **^^Charge^^** ability, immediately after that ability has been resolved, roll a number of dice equal to the unmodified charge roll for that ability. For each 4+, inflict 1 mortal damage on the target.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Premeditated Demise" id="786f-bfa7-56e0-d89b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" id="e5c3-df70-c6fd-3c52" hidden="false" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic>
            <characteristic name="Declare" id="2393-4888-f08b-4839" hidden="false" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit within 12&quot; of the **Neferata** in this Regiment of Renown to be the target.</characteristic>
            <characteristic name="Effect" id="248a-9d6f-9d20-3f41" hidden="false" typeId="b6f1-ba36-6cd-3b03">Until the start of your next turn, ward rolls cannot be made for damage points inflicted on the target by attacks made by units in this Regiment of Renown</characteristic>
            <characteristic name="Keywords" id="7642-7129-873d-8e75" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="The Blood Queen&apos;s Will" id="b117-92cb-72b0-da64" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" id="cfa-cb85-915c-4a3c" hidden="false" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), End of Any Turn</characteristic>
            <characteristic name="Declare" id="cdc7-c48a-279e-ad71" hidden="false" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit contesting an objective that the **Neferata** in this Regiment of Renown is contesting to be the target.</characteristic>
            <characteristic name="Effect" id="4a5c-c51f-4907-8e01" hidden="false" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 2-5, subtract 10 from the control score of the target for the rest of the turn. On a 6, the target has a maximum control score of 1 for the rest of the turn.</characteristic>
            <characteristic name="Keywords" id="4c57-23b7-e9a1-8519" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
