          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of melee weapons used by units in this Regiment of Renown while they are wholly within 12&quot; of the **Ushoran** in this Regiment of Renown.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deranged Transformation" id="7cd6-d94d-c00e-a3de" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
