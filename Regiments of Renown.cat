          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a Fight ability for a unit in this Regiment of Renown</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick a unit in this Regiment of Renown that has not used a **^^Fight^^** ability this turn to be the target. The target can be picked to use a **^^Fight^^** ability immediately after the Fight ability used by this unit has been resolved</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b">The unit using that **^^Fight^^** ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regiment of Renown: Elthwin&apos;s Thorns" id="607c-260c-46a7-1772" defaultAmount="0" hidden="true" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="upgrade">
