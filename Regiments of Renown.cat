            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Units in this Regiment of Renown are not visible to enemy units more than 12&quot; from them while they are wholly within 9&quot; of the **Treelord** in this Regiment of Renown.</characteristic>
          </characteristics>
        </profile>
        <profile name="Endless Wandering" id="a70d-fb07-ff60-b7d6" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
