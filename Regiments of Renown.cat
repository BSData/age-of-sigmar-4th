                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Enemy Combat Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an unit in this Regiment of Renown that is in combat with an enemy unit that charged this turn to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll 2D6. On a 6+, the target can move a number of inches equal to the roll. It can move through the combat ranges of enemy units but cannot end that move in combat.</characteristic>
