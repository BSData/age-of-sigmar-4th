        <constraint id="b575-49e5-9abb-036d" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="db1a-c813-3bde-2f05" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Hatred for All" id="edf7-7af8-5f57-88f2" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You must use this ability if this unit is not in combat and there are any other visible friendly units within this unit&apos;s combat range. You must pick 1 of those friendly units to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Resolve combat attacks for this unit against the target.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regiment of Renown: Casket of Resurrections" id="fdc3-9b98-d03c-abfe" defaultAmount="0" hidden="true" import="true" publicationId="67f7-aa7f-294f-880d" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="5c71-d5bc-44a8-2bbf" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
