    <selectionEntry name="Regiment of Renown: Enforcers of the Tithe" id="658d-08d4-eceb-91d1" defaultAmount="0" hidden="true" import="true" publicationId="fdea-639c-1111-eecc" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="1bc9-ab23-f3b4-3ba2" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
