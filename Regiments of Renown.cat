    </selectionEntry>
    <selectionEntry name="Regiment of Renown: The Coven of Thryx" id="150d-a90c-85bb-d589" defaultAmount="0" hidden="true" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="upgrade">
