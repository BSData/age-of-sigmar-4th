    <selectionEntry name="Gotrek Gurnisson" id="0435-3bc2-403a-b92d" hidden="false" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="unit">
      <categoryLinks>
        <categoryLink name="UNIQUE" id="eb4e-729f-3083-9005" hidden="false" primary="false" targetId="72ce-2188-70bf-2dbd"/>
        <categoryLink name="HERO" id="28fe-6530-e592-dbcd" hidden="false" primary="true" targetId="6e72-1656-d554-528a"/>
