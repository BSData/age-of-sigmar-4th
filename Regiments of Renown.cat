      </modifiers>
      <profiles>
        <profile name="Dead Cunning, for a Gargant" id="bae6-a0a4-7f73-5c83" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, the unit in this Regiment of Renown has **^^Strike-last^^** and **^^Ward (5+)^^**. Pick 1 of the following effects to apply for the rest of the turn:

***A Kunnin&apos; Ruse:*** Other than the **Companion** ability, weapon abilities for attacks that target the unit in this Regiment of Renown have no effect.

***A Nasty Surprise:*** Add 1 to hit rolls for the unit in this Regiment of Renown&apos;s combat attacks and ignore negative modifiers to hit rolls and wound rolls for its combat attacks.

***Tricked Ya!:*** Enemy units have a maximum control score of 1 while they are in combat with the unit in this Regiment of Renown.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
