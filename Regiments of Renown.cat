      <profiles>
        <profile name="Toe to Toe" id="6b3c-ea6b-730e-c48f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Rampage^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Subtract 10 from the control scores of enemy **^^Monsters^^** while they are in combat with any units in this Regiment of Renown.</characteristic>
          </characteristics>
        </profile>
        <profile name="Grimnir&apos;s Defiance" id="ebb9-6ccb-6254-0745" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Units in this Regiment of Renown cannot be picked to be the target of **^^Rampage^^** abilities used by enemy units.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regiment of Renown: Big Grikk&apos;s Kruleshots" id="f73f-20b6-b89b-a7c2" defaultAmount="0" hidden="true" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="upgrade">
