            <characteristic name="Effect" id="60-cb6b-8b6-c116" hidden="false" typeId="fd7f-888d-3257-a12b">Each time a unit in this Regiment of Renown is set up, add 1 to the Attacks characteristic of that unit&apos;s melee weapons for the rest of the turn</characteristic>
          </characteristics>
        </profile>
        <profile name="Stalking Blades" id="3d48-3f31-1ce9-cd84" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick the **Mannfred von Carstein** in this Regiment of Renown to cast this spell, pick a visible enemy unit within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict 1 mortal damage on the target for each other enemy unit within 3&quot; of the target.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Cover of Night" id="ddcd-a852-8659-de7f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
