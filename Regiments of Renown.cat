            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick this unit&apos;s **passengers** to be the targets.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up each target wholly within 6&quot; of this unit and more than 9&quot; from all enemy units. In addition, the targets&apos; melee weapons have **Charge (+1 Damage)** for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
