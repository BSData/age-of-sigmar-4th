        <profile name="Unstoppable Battle Fury" id="8e9a-26f0-33a5-50e9" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
