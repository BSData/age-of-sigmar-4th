                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignore the first damage point allocated to each friendly **^^Ossiarch Bonereapers Infantry^^** unit in the combat phase while they are wholly within 12&quot; of this unit.</characteristic>
