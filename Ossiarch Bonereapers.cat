                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Start of Battle Round</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">When picking a friendly **^^Ossiarch Bonereapers Hero^^** to be the target of the &apos;Immortal Elite&apos; ability this battle round, you can pick a friendly **^^Ossiarch Bonereapers Hero^^** that has been destroyed.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
