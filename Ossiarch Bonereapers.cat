              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Ossiarch Bonereapers^^** unit that charged this turn to use this ability.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, this unit&apos;s melee weapons, including **Companion** weapons, have **Crit (2 Hits)** for the rest of the turn.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Remorseless Conquerors" id="8d69-f531-8cf1-3481" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4785-ebba-30a1-220b" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Remorseless Conquerors" id="a167-ec5d-7abf-b76f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
