              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly non-**^^Squig Moonclan^^** unit that is contesting an objective to be the target.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, add 1 to the control score of the target unit for each model in that unit that is not contesting any objectives.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
