          </characteristics>
        </profile>
        <profile name="Ashigaroth&apos;s Hunger" id="de1a-8f94-972-11fb" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
