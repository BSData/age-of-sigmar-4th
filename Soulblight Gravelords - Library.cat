          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a friendly **^^Soulblight Gravelords Wizard^^** casts a **^^Summon Spell^^** from the &apos;Manifestations of the Grave&apos; lore, you can measure the range and visibility from this terrain feature instead.</characteristic>
          </characteristics>
