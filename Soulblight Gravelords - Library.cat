          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible unit within 12&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">If the target is an enemy unit, inflict D3 mortal damage on it. If the target is a friendly **Deathrattle** or **Deadwalkers** unit, subtract 1 from wound rolls for combat attacks that target that unit for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="The Court of the Lost" id="2818-3961-cf61-ff48" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
