          </attributes>
          <characteristics>
            <characteristic name="Timing" id="e0fc-82e7-be37-43a0" hidden="false" typeId="652c-3d84-4e7-14f4">Reaction: You declared the &apos;Redeploy&apos; command for a **^^Soulblight Gravelords^^** unit wholly within 12&quot; of this unit</characteristic>
            <characteristic name="Declare" id="e552-25b5-e76e-4bcd" hidden="false" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" id="e603-4e99-ebf8-f420" hidden="false" typeId="b6f1-ba36-6cd-3b03">The unit using the &apos;Redeploy&apos; command can move into combat when using that ability</characteristic>
