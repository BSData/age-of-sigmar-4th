          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">You can re-roll resistance rolls for friendly **^^Ruination Chamber^^** units while they are wholly within 12&quot; of this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Guardian of the Final Threshold" id="2c27-5b47-296b-db90" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
