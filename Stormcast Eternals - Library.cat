          <characteristics>
            <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
            <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
            <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Make a chanting roll of D6.</characteristic>
            <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">For the rest of the turn, each time a friendly **^^Ruination Chamber^^** unit uses a **^^Fight^^** ability while it is wholly within 18&quot; of this unit, after that ability has been resolved:
• **Heal (D3)** that unit. If the chanting roll was 8+, **Heal (3)** that unit instead.
• That unit has **^^Ward (6+)^^** for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Dark Flight" id="a32d-9c0c-4123-5b58" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
