        <profile name="Demands of the Witness" id="9f8b-a0b5-fbdf-61da" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
          <attributes>
            <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
            <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
            <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
            <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
            <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a visible friendly **^^Ruination Chamber^^** unit wholly within 12&quot; of this unit to be the target, then make a chanting roll of D6.</characteristic>
            <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, add 1 to the Rend characteristic of each target&apos;s melee weapons. If the chanting roll was 7+, you can pick another eligible unit to be a second target.</characteristic>
            <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="On Wings of Death" id="f45d-f780-c812-2f6d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If the target charged this turn, apply the effects below. Otherwise, roll a dice. On a 3+, apply the effects below: 

• You can remove this unit from the battlefield and set it up again within 1&quot; of the target.
• Subtract 1 from hit rolls for the target&apos;s attacks for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="The Flames of Hope" id="9ae0-f9ad-0eb9-6781" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
