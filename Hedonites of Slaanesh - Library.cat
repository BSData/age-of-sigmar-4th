        <profile name="Delightful Defeatism" id="61c8-6dc4-88e4-525f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a visible enemy unit within 18&quot; of this unit uses the &apos;Rally&apos; command, your opponent must make 3 fewer rally rolls of D6.</characteristic>
          </characteristics>
        </profile>
        <profile name="Like Nails on a Chalkboard" id="db20-0dcd-0c64-ec1c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Reaction: Opponent declared the &apos;Eruption of Fury&apos; ability for a unit within 12&quot; of and visible to this unit</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You and your opponent must roll off. If you roll higher, pick another unit (friendly or enemy) within the combat range of the enemy unit using the &apos;Eruption of Fury&apos; ability. That unit is now the target of that &apos;Eruption of Fury&apos; ability. Your opponent must spend as many **rage dice** as possible as part of that ability, to a maximum of 3.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="78a1-f6c2-71b8-270a" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="0151-9c5b-2f1e-32d4" childName="✦ General&apos;s Handbook 2026-27" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier field="error" type="add" value="A roster cannot contain both the standard and Scourge of Aqshy variant of the same unit.">
              <conditions>
                <condition childId="37ec-d134-cffd-d637" childName="Infernal Enrapturess, Herald of Slaanesh" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
