        <profile name="Arcane Seductor" id="8209-3644-0b7c-c1b2" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Start of Battle Round</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy **^^Wizard^^** or **^^Priest^^** within 18&quot; of this unit to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. If the roll is higher than the target&apos;s power level, for the rest of the battle round, while the target is within 18&quot; of this unit:
• Subtract 1 from the casting rolls and chanting rolls for enemy units while they are within 18&quot; of this unit.
• Add 1 to this unit&apos;s power level.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Synessa, the Voice of Slaanesh" id="e97e-9533-7134-6317" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
