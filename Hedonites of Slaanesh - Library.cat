            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Subtract 1 from casting rolls and unbinding rolls for enemy **^^Wizards^^** while they are within 12&quot; of this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Disharmonious Song" id="8717-9ccb-05bd-ff7a" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
