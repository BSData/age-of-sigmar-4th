      <profiles>
        <profile name="Syll&apos;Esske, the Vengeful Allegiance" id="c826-b44d-3978-2c35" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic>
