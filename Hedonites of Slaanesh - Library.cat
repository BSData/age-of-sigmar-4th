                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time an enemy unit within 12&quot; of this unit uses an ability that results in any slain models being returned to it, after that ability has been resolved, return 1 slain model to this unit.</characteristic>
