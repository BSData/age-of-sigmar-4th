            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Enemy Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Sybarite^^** unit wholly within 12&quot; of this unit to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (6)** the target or return a number of slain models to the target with a combined Health characteristic of up to 3.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Paragon Of Gluttony" id="c8a2-0759-eba5-ebfa" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Start of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 of the following delicacies for Glutos to savour. You cannot pick a delicacy that you picked in the previous turn. The effect applies for the rest of the turn.


***Hear of a Shadow Daemon:*** While they are wholly within 12&quot; of this unit, friendly non-**^^Monster Hedonites of Slaanesh^^** units are not visible to enemy units more than 12&quot; from them.


***Blood of an Aelven Princeling:*** Each time a friendly **^^Hedonites of Slaanesh^^** unit wholly within 12&quot; of this unit uses a **^^Run^^** ability if you  roll a 1-3 when determining the diistance that unit can move, you can use a value of 4 instead.


***Crushed Incarnate&apos;s Core:*** Add 1 to unbinding rolls and banishment rolls for this unit.


***Unspeakable Viscera:*** Inflict D6 mortal damage on each other unit (friendly and enemy) within this unit&apos;s combat range.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Crippling Famishment" id="28b9-9c9b-3e06-d093" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible enemy unit within 18&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn:
• Halve the target&apos;s Move characteristic.
• Halve run rolls and charge rolls for the target.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Battle Damaged" id="8dce-246a-9a52-2f1f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
