        <profile name="Syll&apos;Esske, the Vengeful Allegiance" id="c6aa-2ba3-b977-1029" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic>
