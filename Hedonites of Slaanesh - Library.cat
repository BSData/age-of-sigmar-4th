        <profile name="Thricefold Court" id="780e-fdb0-0097-1185" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Start of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 of the following effects that you did not pick in the previous turn. The effect applies for the rest of the turn:


***Sins of Soul:*** While an enemy **^^Wizard^^** or **^^Priest^^** is visible to this unit, add 1 to this unit&apos;s power level.


***Sins of Flesh:*** This unit&apos;s attacks score critical hits on unmodified hit rolls of 5+.


***Sins of Mind:*** Each time a visible friendly **^^Hedonites of Slaanesh^^** unit wholly within 12&quot; of this unit uses the &apos;Rally&apos; command, you receive 3 additional rally points.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Gifts Of Pain And Pleasure" id="a4f8-80d5-c696-6e36" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick either a visible friendly **^^Hedonites of Slaanesh Infantry^^** unit wholly within 12&quot; of this unit or a visible enemy unit wholly within 12&quot; of this unit to be the target. Then, make a casting roll of 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">If the target is a friendly unit, add 2&quot; to its Move characteristic until the start of your next turn.


If the target is an enemy unit, inflict X mortal damage on it, then **Heal (X)** this unit. X is equal to the number of models in this unit.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
