          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time an enemy unit uses a command while it is within 12&quot; of this unit, give 1 **indulgence point** to this unit, to a maximum of 6.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sublime Harmonies" id="ded0-5f05-9f9c-9940" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
