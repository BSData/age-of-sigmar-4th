          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit&apos;s **Blissbrew Homonculi** are tokens. There is 1 **Blissbrew Homonculus** for every 10 models in this unit.


This unit has **Ward (6+)** while it has any **Blissbrew Homonculi**. If you make an unmodified ward roll of 1 for this unit, remove 1 of this unit&apos;s **Blissbrew Hoomonculi** from the battlefield (the damage point is still inflicted).</characteristic>
          </characteristics>
        </profile>
        <profile name="The Thrill Of Combat" id="6ea8-0747-9ff8-42fb" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
