              <profiles>
                <profile name="Rusty Leadbelcher Gun" id="9973-476a-29f2-9433" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
