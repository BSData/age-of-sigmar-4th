      </categoryLinks>
      <profiles>
        <profile name="Thrive on the Attack" id="d736-5283-e7cf-2d4d" hidden="false" publicationId="4a1e-2c36-6a96-9434" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6"/>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4"/>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Friendly **^^Astral Templars^^** units cannot use the &apos;All-out Defence&apos; command. However, up to 2 friendly **^^Astral Templars^^** units can use the &apos;All-out Attack&apos; command each phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Live off the Land" id="980a-4783-3a2e-a124" hidden="false" publicationId="4a1e-2c36-6a96-9434" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5"/>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4"/>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Astral Templars^^** unit that is wholly within enemy territory and not in combat to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** the target.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Thundrous Roar" id="48d3-898f-673e-d101" hidden="false" publicationId="4a1e-2c36-6a96-9434" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801"/>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7"/>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Your Movement Phase</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Pick a friendly **^^Astral Templars^^** unit to be the target.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">The next time you make a run roll for the target this phase, roll 1 additional dice, to a maximum of 2.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Hunter&apos;s Prowess" id="c5c6-a750-52a3-2f2f" hidden="false" publicationId="4a1e-2c36-6a96-9434" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6"/>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4"/>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time you declare an **^^Attack^^** ability for a friendly **^^Astral Templars^^** unit, you gain 1 **hunter&apos;s prowess point**.
Each time a combat attack made by a friendly **^^Astral Templars^^** unit scores a critical hit, you can spend 1 **hunter&apos;s prowess point**. If you do so, inflict 1 mortal damage on the target after the **^^Attack^^** ability has been resolved.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
