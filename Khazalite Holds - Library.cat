            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this unit is destroyed, before removing it from play, give each visible friendly **^^Grimmdron^^** unit within 6&quot; of it 1 grudge mark.</characteristic>
          </characteristics>
        </profile>
        <profile name="Masterflame Rune" id="248c-6c85-a8b3-f3f0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
