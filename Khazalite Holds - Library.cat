      <profiles>
        <profile name="Thrynn on War Throne" id="8229-7be8-747d-f1ae" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">16</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Battle Damaged" id="51c5-7b2c-4b7b-e84c" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit has 10 or more damage points, the Attacks characteristic of its **Karak War Council&apos;s Armoury** is 4.</characteristic>
          </characteristics>
        </profile>
        <profile name="Defend the Throne!" id="7821-32c9-2f83-45fb" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Start of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick another visible friendly **^^Khazalite Holds^^** unit wholly within 12&quot; of this unit to be a target. For each grudge mark this unit has, you can pick another eligible unit to be an additional target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, the targets&apos; melee weapons have Anti-charge (+1 Rend) while they are wholly within 6&quot; of this unit. Add 3&quot; to this range for each grudge mark this unit has.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Karak War Council" id="303f-3bcb-43a4-8913" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Your Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 of the following effects to apply until the start of your next turn:
**Stonesmith&apos;s Passage:** *The Stonesmith shifts rock and earth to aid the manoeuvres of nearby duardin.* Add 2&quot; to the Move characteristic of visible friendly **^^Khazalite Holds Infantry^^** units while they are wholly within 12&quot; of this unit. In addition, no mortal damage is inflicted on those friendly units by **^^Retreat^^** abilities.
**Grudgebearer&apos;s Accusation:** *The grudgebearer singles out an enemy champion to be the target of the duardin&apos;s vengeance.* Pick a visible enemy **^^Hero^^** within 18&quot; of this unit to be the target. Friendly **^^Khazalite Holds Infantry^^** units can ignore the effects of the &apos;Guarded Hero&apos; ability on the target when picking targets for their shooting attacks.
**Holdseeker&apos;s Protection:** *Awakening the runes on their staff, the holdseeker imbues nearby duardin with an aura that repels the attacks of the foe.* Pick a visible friendly **^^Khazalite Holds^^** unit wholly within 12&quot; of this unit to be the target. Roll a dice. On a 3+, other than the Companion weapon ability, weapon abilities for attacks that target that friendly unit have no effect.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
