        <profile name="Book of Fallen Holds" id="8670-ada2-59da-a8f6" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Start of First Battle Round</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You must use this ability. Pick an enemy unit to be grudged. You can pick an enemy unit in reserve.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the battle:
• While the grudged enemy unit is within 12&quot; of and visible to this unit, you can re-roll charge rolls for friendly **^^Khazalite Holds^^** units while they are wholly within 12&quot; of this unit.
• While there is no grudged enemy unit on the battlefield, add 3 to the control scores of friendly **^^Khazalite Holds^^** units while they are wholly within 12&quot; of this unit.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Talisman of the Lost Karak" id="ba60-9726-bbaa-be97" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this unit is in combat, add 1 to hit rolls for combat attacks made by friendly non-**^^Hero Khazalite Holds Infantry^^** units while they are within 3&quot; of and visible to this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Last of Her Clan" id="beba-290b-51b8-197d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
