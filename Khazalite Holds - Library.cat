        <profile name="Fearless Charge" id="bdff-c0b5-9b20-d84f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to charge rolls for visible friendly **^^Khazalite Holds Infantry^^** units while they are wholly within 12&quot; of this unit. While this unit has any grudge marks, add 2 to charge rolls for visible friendly **^^Khazalite Holds Infantry^^** units while they are wholly within 12&quot; of this unit instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="Dauntless Assault" id="e94f-9e58-3cf5-bc5e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared a **^^Fight^^** ability for this unit or a non-**^^Hero Grimmdron Infantry^^** unit within 3&quot; of this unit</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If you declared a **^^Fight^^** ability for this unit, pick a friendly non-**^^Hero Grimmdron Infantry^^** unit that has not used a **^^Fight^^** ability this turn, is within this unit&apos;s combat range and is visible to this unit to be the target. The target can be picked to use a **^^Fight^^** ability immediately after the **^^Fight^^** ability used by this unit has been resolved. If it is picked to do so, add 1 to hit rolls for the target&apos;s attacks for the rest of the turn.
If you declared a **^^Fight^^** ability for a friendly non-**^^Hero Grimmdron Infantry^^** unit, if this unit has not used a **^^Fight^^** ability this turn, it can be picked to use a **^^Fight^^** ability immediately after the **^^Fight^^** ability used by the friendly non-**^^Hero Grimmdron Infantry^^** unit has been resolved. If it is picked to do so, add 1 to hit rolls for this unit&apos;s attacks for the rest of the turn.
**Designer&apos;s Note:** *This ability lets another friendly unit fight immediately after this unit or lets this unit fight immediately after that other friendly unit. Add 1 to hit rolls for whichever of those two units fights after the first.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
