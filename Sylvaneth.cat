                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">The first time this unit would be destroyed, before removing it from play, roll a die. On a 3+, this unit is not destroyed and any remaining damage points inflicted on it have no effect. **Heal (D3)** this unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Amberglade Nectar" id="e4e4-838a-a42b-98d7" hidden="false" import="true" publicationId="61ee-fae0-f1da-2591" type="upgrade">
