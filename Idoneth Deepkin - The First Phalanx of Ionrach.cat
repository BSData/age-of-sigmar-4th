            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You must spend 1 **asydrazor point** each time a friendly **^^First Phalanx^^** unit uses this ability. Pick a friendly unit that is not in combat to use this ability.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add 1 to charge rolls for that unit for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Asydrazor^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
