      <profiles>
        <profile name="Teachings of the Asydrazor" id="70fe-fb66-4bf8-9f5a" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
