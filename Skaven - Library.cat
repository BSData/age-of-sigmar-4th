          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If the current battle round number is odd, add 2&quot; to the Move characteristic of friendly **^^Skaven^^** units while they are wholly within 13&quot; of this unit. If the current battle round number is even, subtract 1 from hit rolls for attacks made by enemy units that target a friendly **^^Skaven^^** unit while it is wholly within 13&quot; of this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Echoes of the Vermindoom" id="0bd0-f3db-8eac-1f63" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
