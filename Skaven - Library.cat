            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each friendly **^^Skaven^^** unit wholly within 13&quot; of this unit to be the targets.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** each target.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
