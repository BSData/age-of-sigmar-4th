          <rules>
            <rule name="Enhancement Restrictions" id="0ae8-14ff-955a-ac5d" hidden="true">
              <description>A Firing Drill is a unique enhancement that can be given to non-**^^Hero Greywater Fastness^^** units. A unit can only have 1 **Firing Drill**.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Close-range Salvo!" id="862d-e724-7d16-7a8e" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="038a-a92b-0a37-4ba7" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
