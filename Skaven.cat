            <selectionEntry name="Skilled Manipulator" id="928-9300-c265-3c7a" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9c91-5f5f-597b-b359" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
