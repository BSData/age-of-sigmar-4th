          <profiles>
            <profile name="Will of the Horned Rat" id="a36c-88c6-9cd2-f203" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
