                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: A friendly unit within 12&quot; of this unit was picked to be the target of an enemy **^^Spell^^** ability.</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 4+:
• Ignore the effect of that spell on that friendly unit.
• Inflict D3 mortal damage on the caster.
This unit can use this ability more than once per phase but you can only roll once for each friendly unit per spell cast.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
