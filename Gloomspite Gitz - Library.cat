            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If any attacks made with this unit&apos;s **Flinger** score a hit, after the **^^Shoot^^** ability has been resolved, roll a dice. On a 2+, the target unit is **entangled** until the start of your next turn. Halve the Move characteristic of a unit while it is **entangled**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Beast-binding Webbing" id="3588-8ea6-b50e-acd" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
