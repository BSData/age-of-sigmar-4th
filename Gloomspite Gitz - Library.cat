            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick this unit if it is **skittering through tunnels** in reality.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up this unit anywhere on the battlefield more than 9&quot; from all enemy units.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
