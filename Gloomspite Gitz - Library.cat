          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">When this unit is destroyed, before removing it from play, the players must roll off. The winner picks a point on the battlefield within 3&quot; of this unit. Inflict D3 mortal damage on each unit (friendly and enemy) within 3&quot; of that point that has a lower Health characteristic than this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stuff &apos;Em in Me Bag" id="7d20-cd5e-e039-a91a" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
