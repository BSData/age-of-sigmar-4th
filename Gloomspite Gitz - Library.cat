                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Charge Phase</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this phase, pick any number of enemy units within 1&quot; of it to be the targets.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice and add the number of targets to the roll. If the result is less than 6, inflict 1 mortal damage on each target and repeat the sequence, but add another dice to the roll each time you do so.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Boinging Ker-splat!" id="6889-2a5c-a15a-d82e" hidden="true">
                      <description>**^^Squig Monster^^** only. Add the &apos;Boinging Ker-splat!&apos; ability to your hero&apos;s warscroll. You cannot pick this upgrade if your hero has another **^^Rampage^^** ability.</description>
                    </rule>
                  </rules>
                </selectionEntry>
