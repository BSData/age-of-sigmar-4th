                  <profiles>
                    <profile name="Vicious Until the End" id="c359-5dca-7344-278f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this unit is destroyed, before removing it from play, pick an enemy unit in combat with it and roll a number of dice equal to this unit&apos;s health characteristic. For each 5+, inflict 1 mortal damage on that enemy unit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
