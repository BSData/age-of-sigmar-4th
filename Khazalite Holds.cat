      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup name="Heirlooms of the Karaks" id="c9f8-a2a4-0ea6-26a9" hidden="false" publicationId="f98d-040f-7b3e-eaf1">
          <rules>
            <rule name="Enhancement Restrictions" id="6644-2ce2-9974-17e3" hidden="true">
              <description>**^^Hero^^** only</description>
            </rule>
          </rules>
