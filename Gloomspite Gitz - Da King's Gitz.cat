            <selectionEntry name="Da King&apos;s Adjutant" id="08c2-0848-7f23-2b3d" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="46b3-0054-afdb-3e95" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Da King&apos;s Adjutant" id="5939-9dfe-b508-9604" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), End of Your Turn</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">You cannot use this ability and the **Bad Moon Loonshrine&apos;s** &apos;Moonclan Lairs&apos; ability in the same turn. While this unit is within 12&quot; of a friendly **Bad Moon Loonshrine**, pick a friendly non-reinforced, non-**^^Hero^^**, non-**^^Monster King&apos;s Gitz^^** unit that has been destroyed to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up a replacement unit wholly within 12&quot; of a friendly **Bad Moon Loonshrine** and more than 3&quot; from all enemy units.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Glarejester" id="faa0-9d4f-8ed4-d169" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e8d0-433c-a696-5bd5" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Glarejester" id="0c80-f880-d338-daf0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Infantry^^** unit within 3&quot; of this unit and that is not in combat to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. Add the roll to the distance the target can move when using **^^Move^^** abilities this phase. If the target ends a move in this phase within 3&quot; of this **^^Hero^^**, inflict an amount of mortal damage on this **^^Hero^^** equal to the roll.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
