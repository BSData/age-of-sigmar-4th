              <profiles>
                <profile name="Moonhoned Shiv" id="b002-1e2f-e7d3-7368" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
