        <profile name="Masters of Order" id="a7d5-1ea4-f890-7a84" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to casting rolls for this unit. In addition, this unit can use an **^^Unbind^^** ability if an enemy **^^Wizard^^** anywhere on the battlefield uses a **^^Spell^^** ability instead of an enemy **^^Wizard^^** within 30&quot; of this unit, and when using the &apos;Banish Manifestation&apos; ability, this unit can pick a manifestation anywhere on the battlefield instead of within 30&quot; of it.</characteristic>
          </characteristics>
        </profile>
        <profile name="Celestial Reinforcements" id="2fa9-8fb2-f984-fa9e" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Yellow</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Once Per Turn (Army), Your Hero Phase</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Pick a friendly **^^Seraphon^^** unit that started the battle with 3 or more models and that has been destroyed to be the target.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Set up a replacement unit with half the number of models from the target unit (rounding up) wholly within 12&quot; of this unit and more than 9&quot; from all enemy units.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Celestial Equilibrium" id="c7df-4c-19b2-6c40" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Make a casting roll of 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">For the rest of the turn, add 1 to casting rolls made for other friendly **^^Seraphon Wizards^^** while they are wholly within 12&quot; of this unit.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Arcane Vassal" id="1dee-3033-449b-90fc" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn, Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **^^Skink Wizard^^** wholly within 18&quot; of this unit to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Measure the range and visibility of the next **^^Spell^^** ability used by this unit this phase from the target instead of from this unit. The target is treated as the caster for the purpose of other abilities or spell effects, such as &apos;Unbind&apos; or &apos;The Earth Trembles&apos;.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
