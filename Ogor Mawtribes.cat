          <selectionEntries>
            <selectionEntry name="Leave Not a Morsel" id="b279-4201-e5bd-8ef3" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
              <constraints>
                <constraint id="7465-5a09-028c-6354" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Leave Not a Morsel" id="aeac-1f3f-e463-c025" hidden="false" publicationId="1ac6-e227-a186-12" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While they are within 6&quot; of and visible to this unit, enemy units cannot be healed or have slain models returned to them.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Dreaded Far and Wide" id="b63a-a9f5-1f8b-5cbc" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
              <constraints>
                <constraint id="80f1-b758-d285-17ff" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Dreaded Far and Wide" id="ebcf-81b7-f136-b6db" hidden="false" publicationId="1ac6-e227-a186-12" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignore negative modifiers to:
• This unit&apos;s control score.
• Hit rolls and wound rolls for this unit&apos;s non-**Companion** attacks.
• Charge rolls for this unit.
• The number of dice rolled when making charge rolls for this unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="The Crusherguts" id="b6f3-c71d-0335-9c2b" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
              <constraints>
