          <profiles>
            <profile name="Fixated on Feeding" id="61b5-bcbd-74a9-c95d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
