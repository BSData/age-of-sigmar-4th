                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Subtract 1 from ward rolls for enemy units while they are within 6&quot; of this unit.</characteristic>
                  </characteristics>
                </profile>
