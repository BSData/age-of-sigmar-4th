          </modifiers>
          <profiles>
            <profile name="Domination Hexes" id="2c38-a3cb-bc21-ca71" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Double the Health characteristic of friendly non-**^^Hobgrot Helsmiths of Hashut^^** units for the purposes of the &apos;Power Through&apos; command.
**Designer&apos;s Note:** *The effect of this ability applies both when you use &apos;Power Through&apos; and when your opponent uses &apos;Power Through&apos;.*</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Industrial Polluters" id="e205-0a56-5ded-d73d" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
