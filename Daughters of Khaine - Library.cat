            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to casting rolls for this unit when it uses a **^^Summon^^** ability and add 1 to banishment rolls for this unit.</characteristic>
          </characteristics>
        </profile>
