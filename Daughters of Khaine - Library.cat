            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, each time a visible friendly **^^Daughters of Khaine^^** unit wholly within 12&quot; of this unit uses a **Fight** ability, after that ability has been resolved, you can pick a visible friendly **^^Daughters of Khaine Priest^^** wholly within 12&quot; of this unit. That **^^Priest^^** gains 1 ritual point.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Exalted^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
