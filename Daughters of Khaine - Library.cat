          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Exalted^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a friendy **^^Daughters of Khaine^^** unit wholly within 12&quot; of this unit uses the &apos;Rally&apos; command, you can make 3 additional rally rolls of D6. In addition, if there are any friendly **Hag Queens on Cauldrons of Blood** on the battlefield when that command is used, you receive D3 additional rally points.</characteristic>
          </characteristics>
        </profile>
      </profiles>
