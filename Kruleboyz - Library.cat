        <profile name="Jump &apos;Em, Ladz, Or Else!" id="5a7b-b023-56e6-373a" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
