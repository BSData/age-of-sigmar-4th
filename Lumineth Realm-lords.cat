                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Enemy Combat Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit in combat with this unit to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice for each model in this unit that is in combat with the target. For each 4+, inflict 1 mortal damage on the target.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Core^^**, **^^Attack^^**, **^^Fight^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
