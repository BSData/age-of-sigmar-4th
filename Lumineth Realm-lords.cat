            <selectionEntry name="Dazzling Phalanx" id="dba5-d64f-18be-266d" hidden="false" import="true" publicationId="9e18-bb03-7b60-d4ff" type="upgrade">
              <constraints>
                <constraint id="679f-a6d7-4868-5648" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
