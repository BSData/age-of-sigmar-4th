              </constraints>
              <selectionEntries>
                <selectionEntry name="The Bringer of Fire" id="99b3-a55b-686d-54dd" hidden="false" import="true" sortIndex="3" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-2"/>
                  </costs>
                  <profiles>
                    <profile name="The Bringer of Fire" id="a083-bb56-87c1-1630" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a terrain feature that has not yet been set ablaze within this **^^Hero&apos;s^^** combat range to be the target.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">That terrain feature is now set ablaze. Add 1 to this unit&apos;s control score for the rest of the battle (this effect is cumulative). In addition, for the rest of the battle, each time a unit (friend or enemy) ends a move within 3&quot; of a terrain feature that has been set ablaze, roll a D3. On a 2+, inflict an amount of mortal damage on that unit equal to the roll.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Victor of 100 Duels" id="af56-f0ec-9950-0a2c" hidden="false" import="true" sortIndex="2" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-4"/>
                  </costs>
                  <profiles>
                    <profile name="Victor of 100 Duels" id="cd9c-aeb3-b4c7-6ed8" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy **^^Hero^^** in combat with this unit to be the target.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Your opponent must decide whether the target will accept or refuse this unit&apos;s challenge:
***Accept:*** For the rest of the phase, when this unit and the target are picked to use a **^^Fight^^** ability, all of their attacks must target the other unit. In addition, for the rest of the phase, you can re-roll hit rolls for this unit&apos;s combat attacks.
***Refuse:*** The target cannot use **^^Fight^^** abilities for the rest of the phase. In addition, you gain 1 command point.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Betrayed by the False God" id="506b-dfff-87a9-75f0" hidden="false" import="true" sortIndex="1" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-2"/>
                  </costs>
                  <profiles>
                    <profile name="Betrayed by the False God" id="ab0a-1b8c-66ac-6a56" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">You can re-roll hit rolls for this unit&apos;s combat attacks that target enemy **^^Order^^** units.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
