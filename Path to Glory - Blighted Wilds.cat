                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: Your opponent declared a command for a unit within 6&quot; of this unit.</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. If the roll equals or exceeds the number of command points your opponent has, after the command has been resolved, inflict an amount of mortal damage equal to the roll on the unit using that command. This unit can use this ability more than once per phase but only once per command.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
