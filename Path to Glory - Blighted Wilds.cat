                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to casting rolls and chanting rolls for the Curator.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Conduit of Power" id="f65b-94e9-8b55-95aa" hidden="true">
                      <description>Add the &apos;Conduit of Power&apos; ability to your Landmark of Ghyran&apos;s warscroll.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Chained Magic" id="e723-3796-05a1-8b58" hidden="false" import="true" sortIndex="3" type="upgrade">
                  <constraints>
                    <constraint id="7a78-836d-3fbd-8775" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-5"/>
                    <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                    <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Chained Magic" id="737f-a696-5158-c0b6" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this terrain feature has a Curator when it is destroyed, after setting up the Curator on the battlefield, set up a friendly **^^Manifestation^^** that can be summoned using a **^^Summon^^** spell from your Arcane Tome on the battlefield within 3&quot; of this unit and not in combat. If that **^^Manifestation^^** has multiple parts, all parts must be set up within 3&quot; of that unit. That unit has summoned that **^^Manifestation^^**. If there is already a friendly **^^Manifestation^^** of the same type on the battlefield, it is immediately banished and removed from play before being set up as described above.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Chained Magic" id="20dc-173a-f1fa-76f1" hidden="true">
                      <description>Add the &apos;Chained Magic&apos; ability to your Landmark of Ghyran&apos;s warscroll.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Life Tap" id="0a81-6165-0da0-928b" hidden="false" import="true" sortIndex="2" type="upgrade">
                  <constraints>
                    <constraint id="5555-3057-3c32-bee7" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-4"/>
                    <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                    <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Life Tap" id="cb45-b82d-e942-6203" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this terrain feature has a Curator, pick a visible terrain feature within 9&quot; of it to be the target.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 3+, **Heal (X)** this terrain feature, where **X** is an amount equal to the roll. Then, the target is **contaminated** to both players&apos; armies.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Life Tap" id="f391-49fd-fbc5-021e" hidden="true">
                      <description>Add the &apos;Life Tap&apos; ability to your Landmark of Ghyran&apos;s warscroll.</description>
                    </rule>
                  </rules>
                </selectionEntry>
