                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While an enemy unit is in combat with this unit:
• That enemy unit has a maximum control score of 1.
• Subtract 1 from that enemy unit&apos;s power level, to a minimum of 0.
• That enemy unit&apos;s attacks cannot score critical hits (treat them as regular hits instead).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="We All Must Make Sacrifices" id="4a6b-7c7a-af6b-df8b" hidden="false" import="true" type="upgrade">
