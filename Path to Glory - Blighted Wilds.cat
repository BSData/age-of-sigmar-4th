              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Any Combat Phase</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly unit that charged this turn to be the target.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3 and apply the corresponding effect for the rest of the turn.
1 Add 1 to the Attacks characteristic of the target&apos;s melee weapons.
2 Add 1 to the Damage characteristic of the target&apos;s melee weapons.
3 Add 1 to the Damage characteristic of the target&apos;s melee weapons.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
