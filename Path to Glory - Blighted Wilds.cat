                  <profiles>
                    <profile name="Sinister" id="e811-d48b-f07d-ada1" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn, Reaction: Opponent declared a command for a unit within 12&quot; of this terrain feature</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 5+, that command has no effect, it still counts as having been used, and the command points spent to use the command are still lost.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Sinister" id="2c91-007c-5094-1df2" hidden="true">
                      <description>Add the &apos;Sinister&apos; ability to your Landmark of Ghyran&apos;s warscroll.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
            <selectionEntryGroup name="Curator" id="2c59-69bc-af98-c16a" collapsible="true" hidden="false" sortIndex="5">
              <constraints>
                <constraint id="9110-c69b-bbe1-596b" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <selectionEntries>
                <selectionEntry name="Curator" id="347d-1d07-9d23-66c0" hidden="false" import="true" sortIndex="1" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-4"/>
                    <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                    <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Trusted Curator" id="a3c6-d855-1b55-2033" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Hero Phase</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this terrain feature does not have a Curator, pick a friendly **^^Infantry Hero^^** within 3&quot; of it and not in combat to be the target.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Place the target on this terrain feature. The target is now the Curator (see &apos;Ensconced&apos;).</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                    <profile name="Abandon Position" id="559a-ad96-8acf-f7dd" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this terrain feature has a Curator that was not placed on it this turn, set up the Curator on the battlefield wholly within 6&quot; of this terrain feature and not in combat. That unit is no longer the Curator.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                    <profile name="Ensconced" id="8dce-53d3-1b95-89d1" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While this terrain feature has a Curator:
• The Curator cannot use **^^Move^^** abilities.
• Instead of measuring the range or visibility to the Curator, measure to this terrain feature instead.
• All attacks that would target the Curator target this terrain feature instead.
• If this terrain feature is destroyed, before removing it from the battlefield, inflict D3 mortal damage on the Curator. Then, set up the Curator on the battlefield within 3&quot; of this terrain feature and not in combat. That unit is no longer the Curator. If it is not possible to set up the Curator, it is slain.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
