              </constraints>
              <profiles>
                <profile name="Tattermask" id="e6b4-66e7-8f29-7f3f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If the unmodified hit roll for an attack that targets this unit is 1-3, that attack fails and the attack sequence ends.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Spell in a Rattle" id="2010-607b-6161-734a" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4f21-36af-7d52-c497" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Spell in a Rattle" id="6ed3-490a-1e11-6145" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, Any Hero Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">This unit can use a non-**^^Summon^^** **^^Spell^^** ability from a spell lore you picked during army composition as if it had **^^Wizard (1)^^**. Instead of making a casting roll for that spell, the casting roll is 9 and cannot be modified. That spell cannot be unbound.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Woggly Bogstikk" id="ace7-3717-82cc-dcf4" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c6fc-7e74-347a-e27d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
