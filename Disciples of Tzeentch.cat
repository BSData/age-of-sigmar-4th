                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit was set up this turn, it can move D3&quot;. That move cannot pass through or end within the combat range of an enemy unit.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
