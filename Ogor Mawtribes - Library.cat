          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit&apos;s cauldron is either filled with grisly remains or empty. It starts the battle empty. If an enemy unit that was in combat with this unit this turn is destroyed and this unit&apos;s cauldron is empty, it becomes filled with grisly remains.</characteristic>
          </characteristics>
        </profile>
        <profile name="Great Cauldron" id="3b0e-b90f-3322-1c36" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
