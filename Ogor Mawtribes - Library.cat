            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Measure the range and visibility of the next **^^Spell^^** ability used by a friendly **^^Ogor Mawtribes Wizard^^** that is wholly within 12&quot; of and visible to this unit from this unit instead of that **^^Wizard^^**. This unit is treated as the caster for the purpose of other abilities or spell effects, such as &apos;Unbind&apos;.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
