          </characteristics>
        </profile>
        <profile name="Tiny Braggarts" id="a778-73a2-942e-533b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
