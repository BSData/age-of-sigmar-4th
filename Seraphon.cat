                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can pick 2 different Asterism abilities instead of 1. They are both used in addition to the one you picked in the deployment phase.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
