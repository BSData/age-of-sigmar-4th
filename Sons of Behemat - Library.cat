        <profile name="King Brodd" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="a74-da81-6af3-d8c5">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic>
