        <profile name="Ma Maegran, Chooser of the Mighty" id="5f35-3e71-372b-e572" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic>
