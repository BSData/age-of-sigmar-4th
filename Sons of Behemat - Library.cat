    <selectionEntry type="unit" import="true" name="Mancrusher Gargant" hidden="false" id="2e41-3174-d7a3-cded" publicationId="b765-4747-cddc-385e">
      <profiles>
        <profile name="Mancrusher Gargant" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="cec4-bbff-3ef0-91e6">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Bet You Can&apos;t..." typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="519a-ec21-8ff3-adad">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Deployment Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each friendly **Mancrusher Gargant** on the battlefield to be the targets.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Pick 1 of the following effects:

***...Kill the Big &apos;Eads!***: For the rest of the battle, add 1 to the Attacks characteristic of each target&apos;s melee weapons while they are in combat with any enemy **^^Heroes^^** or **^^Monsters^^**.

***...Get There Before Me!***: Up to 3 of the targets can each use the &apos;Normal Move&apos; ability as if it were your movement phase.

***...Grab That!***: Add 5 to each target&apos;s control score for the rest of the battle.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Excitable Followers" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" hidden="false" id="4040-f458-4c37-e6ab">
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Any Combat Phase</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086"/>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">While this unit is wholly within 12&quot; of a visible friendly **^^Sons of Behemat Hero^^**, this unit can use 2 **^^Fight^^** abilities this phase. After the first is used, however, this unit has **^^Strike-last^^** for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce">**^^Rampage^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Red</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Offensive</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="MONSTER" hidden="false" id="1ad6-6275-31d8-f11d" targetId="6d54-625c-d063-13e2" primary="true"/>
