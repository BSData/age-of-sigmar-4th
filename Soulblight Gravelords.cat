              </constraints>
              <profiles>
                <profile name="Shard of Night" id="56a6-4e88-8d98-84ea" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
