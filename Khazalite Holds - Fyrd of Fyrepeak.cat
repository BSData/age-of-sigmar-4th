  <sharedSelectionEntries>
    <selectionEntry name="Battle Traits: Fyrd of Fyrepeak" id="6746-70aa-e460-09e0" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="6b6d-7639-b409-38c0" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Grimmdron Grudges" id="124e-3ad8-bbd2-fbd4" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a friendly **^^Fyrd of Fyrepeak^^** unit destroys an enemy unit, give that friendly unit 1 grudge mark.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rune of Fortune" id="5415-6de7-5f77-cdd4" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can only use this ability if you have not used any **^^Ur-gold Rune^^** abilities this battle round. For the rest of the battle round, if the unmodified hit roll for a shooting attack that targets a friendly **^^Fyrd of Fyrepeak^^** unit is 1-4, the attack fails and the attack sequence ends.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Ur-gold Rune^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Rune of Spellbreaking" id="f4d6-4a6a-6788-c323" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can only use this ability if you have not used any **^^Ur-gold Rune^^** abilities this battle round. For the rest of the battle round:
• Subtract 2 from casting rolls and chanting rolls for enemy units.
• Add 1 to chanting rolls for friendly **^^Fyrd of Fyrepeak^^** units.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Ur-gold Rune^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Rune of Guarding" id="61cf-5b89-8c88-b256" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can only use this ability if you have not used any **^^Ur-gold Rune^^** abilities this battle round. For the rest of the battle round, ignore the first damage point that would be allocated to each friendly **^^Fyrd of Fyrepeak^^** unit in each phase.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Ur-gold Rune^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Rune of Speed" id="6901-e191-df74-1756" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can only use this ability if you have not used any **^^Ur-gold Rune^^** abilities this battle round. For the rest of the battle round, you can re-roll run rolls and charge rolls for friendly **^^Fyrd of Fyrepeak^^** units.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Ur-gold Rune^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Rune of Striking" id="cd61-018c-19cf-4d42" hidden="false" publicationId="f98d-040f-7b3e-eaf1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You can only use this ability if you have not used any **^^Ur-gold Rune^^** abilities this battle round. For the rest of the battle round, add 1 to hit rolls and wound rolls for attacks made by friendly **^^Fyrd of Fyrepeak^^** units.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Ur-gold Rune^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
