                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Movement Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible enemy unit within 12&quot; of this unit to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Spend 1 rage dice. If your opponent&apos;s fury level is lower than yours, they must increase their fury level by 1, to a maximum of 7.
Then, for the rest of the turn:
• Add 1 to charge rolls for the target.
• Each time the target uses a **^^Charge^^** ability, if possible, it must end the charge move within 1/2&quot; of this unit.
• While the target is in combat with this unit, subtract 1 from hit rolls for the target&apos;s combat attacks that do not target this unit.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
