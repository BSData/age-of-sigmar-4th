              <characteristics>
                <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Any Combat Phase</characteristic>
                <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                <characteristic name="Declare" typeId="b77f-7548-840e-c086">Pick a friendly **^^Serfs^^** unit that did not charge this turn and is in combat to use this ability, then pick an enemy unit in combat with that **^^Serfs^^** unit to be the target.</characteristic>
                <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">The target cannot make pile-in moves for the rest of the turn.</characteristic>
                <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
