            <profile name="Indulge, My Pretties" id="251-e2-1282-4e44" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While a friendly non-**^^Hero Flesh-eater Courts Monster^^** or **^^Beast^^** is wholly within 12&quot; of any friendly **^^Flesh-eater Courts Heroes^^**:
• That non-**^^Hero^^** can use a **^^Rampage^^** ability on its warscroll even if that ability has already been used by another friendly **^^Monster^^** in the same turn.
• If that non-**^^Hero^^** unit charged in the same turn and the unmodified charge roll was 9+, it has **^^Strike-first^^** for the rest of the turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Knightly Echelon" id="8efa-7855-fa42-107f" hidden="false" import="true" publicationId="6281-1a88-8f4-946" type="upgrade">
          <constraints>
            <constraint id="2759-27bc-d67e-c07d" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Sound the Charge" id="ef22-66e4-2c51-1883" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Rend characteristic of melee weapons used by friendly **^^Knights^^** that charged in the same turn while they are wholly within 12&quot; of any friendly **^^Flesh-eater Courts Heroes^^**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Royal Hunt" id="be68-2ab8-be60-2150" hidden="false" import="true" publicationId="6281-1a88-8f4-946" type="upgrade">
          <constraints>
            <constraint id="8378-8eb6-d702-5a1" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Like Snapping Hounds" id="dd54-f265-45a3-561d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick each friendly **^^Serfs^^** unit in combat to be the targets.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For each target:
• Make a pile-in move.
• Then, pick an enemy unit in combat with the target and roll a D3. On a 2+, inflict an amount of mortal damage on that enemy unit equal to the roll.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Lords of the Manor" id="b02d-c2df-87f5-daa6" hidden="false" import="true" publicationId="6281-1a88-8f4-946" type="upgrade">
          <constraints>
            <constraint id="a1f7-9103-da2f-2862" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Raise the Banners" id="26f0-7ab2-5f8e-28fa" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time another ability returns at least 1 slain model to a friendly unit that is not in combat, after that ability has been resolved, if that unit is a **^^Serfs^^** unit, you can return 1 additional slain model to it, and if it is a **^^Knights^^** unit, roll a dice. On a 4+, you can return 1 additional slain model to it.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Impassioned Serfs" id="2a27-a0a8-6ecb-37bc" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
