  <sharedSelectionEntries>
    <selectionEntry name="Battle Traits: The Decadent Host" id="7171-e38c-d002-b7bb" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="f66f-d935-4c63-f899" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="The Prince in the Mirror" id="509a-9d35-841e-d7bc" hidden="false" publicationId="95fc-e96f-a916-bba1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Your Movement Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If the friendly **Sigvald** has been destroyed, pick him to be the target. He can be replaced even if he is a replacement unit.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Set up a replacement unit identical to the target wholly within 6&quot; of a friendly **Contorted Epitome** and not in combat.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Perfection Made Manifest" id="b5dc-5d32-6ef9-9bed" hidden="false" publicationId="95fc-e96f-a916-bba1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick the friendly **Sigvald** to use this ability then pick a visible unit (friendly or enemy) within 3&quot; of him to be the target</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Indlict D3 mortal damage on the target. For each model slain by this ability this turn, add 2 to the Attacks characteristic of the friendly **Sigvald**&apos;s melee weapons for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Petulant Weath" id="b2bb-adb3-d3b3-0cb6" hidden="false" publicationId="95fc-e96f-a916-bba1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If the friendly **Sigvald** is not in combat and did not charge this turn, pick him to use this ability, then pick another friendly **^^Decadent Host^^** unit within 1&quot; of him to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Inflict D6 mortal damage on the target. Before removing any slain models from play, remove the friendly **Sigvald** from the battlefield then set him up again within 1&quot; of the target.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Infernal Handmaidens" id="5711-3860-f3e3-21c0" hidden="false" publicationId="95fc-e96f-a916-bba1" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While the friendly **Sigvald** is within 3&quot; of and visible to any friendly **^^Decadent Host Daemon^^** units, add 1 to wound rolls for combat attacks made by those **^^Daemon^^** units.</characteristic>
          </characteristics>
        </profile>
        <profile name="All for the Prince" id="c93e-34c3-63e0-ef22" hidden="false" publicationId="95fc-e96f-a916-bba1" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">While the friendly **Sigvald** is within the combat range of another friendly **^^Decadent Host Sybarite^^** unit:
• He has **^^Ward (2+)^^**.
• Each time you make a successful ward roll for him, allocate 1 damage point to another friendly **^^Decadent Host^^** unit within his combat range after the damage sequence has been resolved (ward rolls cannot be made for those damage points).</characteristic>
          </characteristics>
        </profile>
        <profile name="Important People have Important Places to Be" id="7754-e055-6f23-edb6" hidden="false" publicationId="95fc-e96f-a916-bba1" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If the friendly **Sigvald** is not contesting an objective, he can move 2D6&quot; but must end that move contesting an objective. He can move through the combat ranges of enemy units but cannot end that move in combat.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
