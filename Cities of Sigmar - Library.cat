      <profiles>
        <profile name="Cannonade Cogfort" id="e3e5-de1a-48ba-6fe5" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
