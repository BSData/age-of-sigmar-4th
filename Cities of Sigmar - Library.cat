        </profile>
        <profile name="Crackling with Faith" id="cc19-4eab-a306-e92d" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
