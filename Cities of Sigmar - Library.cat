    <selectionEntry name="Conqueror Cogfort" id="2325-8939-e7a3-5c84" hidden="false" import="true" publicationId="a746-732d-1a22-460" type="unit">
      <categoryLinks>
        <categoryLink name="HERO" id="4197-eeaf-1143-013c" hidden="false" primary="true" targetId="6e72-1656-d554-528a"/>
        <categoryLink name="ORDER" id="a940-abc8-c219-76df" hidden="false" primary="false" targetId="ee22-3575-6590-25c"/>
