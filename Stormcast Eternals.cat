            <selectionEntry name="Blade of the Six Smiths" id="6abf-ea91-c546-6374" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="bcb4-0b6a-326f-fc35" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
