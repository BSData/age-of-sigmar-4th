  <sharedSelectionEntries>
    <selectionEntry name="Battle Traits: Change-cult Uprising" id="61a3-8433-e5ea-d426" hidden="false" import="true" publicationId="72d2-ae0-e519-f2f7" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="6efd-572b-0d0f-5434" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Illusory Infiltration" id="599d-d838-a59e-0cc3" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Deployment Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick up to 3 friendly non-reinforced **^^Change-cult^^** **Kairic Acolytes** units to be the targets.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Remove the targets from the battlefield and set them up again wholly within 3&quot; of a terrain feature and not in combat.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Puppet on a String" id="ba5a-87aa-e8f4-da4e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy **^^Hero^^** within 24&quot; of and visible to a friendly **^^Change-cult Hero^^** to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">For the rest of the turn, each time the target uses a **^^Core^^** ability, gain 1 **fate point**.
**Designer&apos;s Note:** *You can only gain fate points using this ability and the &apos;Spell-eater Pendant&apos; ability.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Silver Simulacrum" id="caf5-ab65-716f-ce82" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Deployment Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If there is a friendly **Argent Shard** on the battlefield, you can set up 1 additional **Argent Shard** on the battlefield. It must be set up wholly within friendly territory and more than 3&quot; from all objectives and other terrain features.
**Designer&apos;s Note**: *The original Argent Shard is set up in Step 1 of the deployment phase using the &apos;Deploy Faction Terrain&apos; ability. This ability allows you to set up a second such terrain feature and is used in Step 3 of the deployment phase, after armies have been deployed.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Overtaken by Events" id="ea7c-4670-a748-8951" hidden="false" typeId="9b15-469e-8bf3-70c7" typeName="Ability (Fate)">
          <attributes>
            <attribute name="Color" typeId="7117-6fca-9b35-9a1b">Yellow</attribute>
            <attribute name="Type" typeId="bafa-c720-e165-8c34">Special</attribute>
            <attribute name="Parent Node" typeId="65cf-bbb1-eb30-7049"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="ee08-f0bb-c101-58d5">Once Per Turn (Army), Any Hero Phase</characteristic>
            <characteristic name="Declare" typeId="74f4-c00a-61c2-280d">Spend 1 **fate point**. Then, pick an enemy unit within 24&quot; of and visible to a friendly **^^Change-cult Hero^^** to be the target.</characteristic>
            <characteristic name="Effect" typeId="c24b-9e80-9805-8ccf">The target cannot use commands for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="3a10-e240-163d-d34a"/>
            <characteristic name="Used By" typeId="fb10-043b-0db8-f864"/>
            <characteristic name="Fate Points" typeId="2817-a813-f11c-2961">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Seeds of Discord" id="355b-cf43-b7a1-3e60" hidden="false" typeId="9b15-469e-8bf3-70c7" typeName="Ability (Fate)">
          <attributes>
            <attribute name="Color" typeId="7117-6fca-9b35-9a1b">Purple</attribute>
            <attribute name="Type" typeId="bafa-c720-e165-8c34">Offensive</attribute>
            <attribute name="Parent Node" typeId="65cf-bbb1-eb30-7049"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="ee08-f0bb-c101-58d5">Once Per Turn (Army), End of Any Turn</characteristic>
            <characteristic name="Declare" typeId="74f4-c00a-61c2-280d">Spend 1 **fate point**. Then, pick an enemy unit within 24&quot; of and visible to a friendly **^^Change-cult Hero^^** to be the target, then pick another enemy unit within the target&apos;s combat range to be the victim.</characteristic>
            <characteristic name="Effect" typeId="c24b-9e80-9805-8ccf">Pick 1 of the target&apos;s melee weapons. Immediately resolve combat attacks for the target made with that weapon against the victim.</characteristic>
            <characteristic name="Keywords" typeId="3a10-e240-163d-d34a"/>
            <characteristic name="Used By" typeId="fb10-043b-0db8-f864"/>
            <characteristic name="Fate Points" typeId="2817-a813-f11c-2961">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
