                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is within 6&quot; of a damaged enemy unit, this unit can move 6&quot;. It can pass through the combat ranges of enemy units but must end that move in combat with a damaged enemy unit.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
