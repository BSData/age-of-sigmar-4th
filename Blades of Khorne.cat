              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add **X** to charge rolls for friendly **^^Blades of Khorne^^** units, where **X** is the number of friendly **^^Blades of Khorne Cavalry^^** or **^^Monster^^** units that have already charged this phase and that are wholly within 12&quot; of the unit being rolled for.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Khornate Legion" id="1437-4357-25cb-fc23" hidden="false" import="true" publicationId="81a9-3dbf-dbc5-672e" type="upgrade">
          <constraints>
            <constraint id="f9bd-6d93-2ad9-3052" field="selections" scope="parent" shared="true" type="max" value="1"/>
