      <profiles>
        <profile name="Duardrazhal" id="a1e4-d207-ca64-8935" hidden="false" publicationId="e47d-cde6-bbd2-9db9" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6"/>
