      <selectionEntryGroups>
        <selectionEntryGroup name="Heroic Traits: New Summercourt" id="8a1e-95c4-ffe1-463b" hidden="false" publicationId="6281-1a88-8f4-946">
          <rules>
            <rule name="Enhancement Restrictions" id="66e2-03d5-a49f-1d27" hidden="true">
              <description>**^^Hero^^** only</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Tip of the King&apos;s Lance" id="fa8d-5354-3688-83a2" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="95f0-54cd-c393-23ba" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Tip of the King&apos;s Lance" id="1620-ee72-e293-99a4" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit charged this turn, it can move 2D6&quot;. It can pass through models in enemy units, but it must end that move in combat.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
