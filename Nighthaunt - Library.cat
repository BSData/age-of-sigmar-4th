                    <profile name="It Tolls for Thee" id="aee0-7ab7-58be-784c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
