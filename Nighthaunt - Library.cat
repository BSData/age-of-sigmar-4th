                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: Your opponent declared a **^^Spell^^** ability</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If a friendly **^^Nighthaunt^^** unit wholly within 12&quot; of rhis unit was picked to be the target of that spell, this unit can use the &apos;Unbind&apos; ability as if it had **^^Wizard (1)^^**. If the spell is unbound, **Heal (D3)** this unit.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Arcane Devourer" id="6cfc-abfd-d586-7250" hidden="true">
                      <description>Non-**^^Wizard^^** only. Your hero gains the &apos;Devour Magic&apos; ability.</description>
                    </rule>
                  </rules>
                </selectionEntry>
