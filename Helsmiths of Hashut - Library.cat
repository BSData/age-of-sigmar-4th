          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">For each **daemonic power point** this unit has:
• Add 1&quot; to its Move characteristic
• Add 1 to the Attacks characteristic of its weapons.</characteristic>
          </characteristics>
        </profile>
      </profiles>
