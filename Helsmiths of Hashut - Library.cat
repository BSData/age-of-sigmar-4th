                    <profile name="Hobgrot Advisor" id="507d-72c7-d913-c9bd" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit&apos;s **Hobgrot Advisor** is a token. While this unit&apos;s **Hobgrot Advisor** is on the battlefield, add 3 to the control scores of friendly **^^Helsmiths of Hashut^^** units wholly within 12&quot; of this unit. If you make an unmodified save roll of 1 for this unit, remove this unit&apos;s **Hobgrod Advisor** from the battlefield, the attack fails, and the attack sequence ends.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Hobgrot Advisor" id="2971-1e96-421f-2237" hidden="true">
                      <description>**^^Infantry^^** only. Add the &apos;Hobgrot Advisor&apos; ability to your hero&apos;s warscroll.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Rigorously Trained" id="e5fd-7e84-9ff0-bc55" hidden="false" import="true" sortIndex="7" type="upgrade">
