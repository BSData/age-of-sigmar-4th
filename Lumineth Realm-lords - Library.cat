        <profile name="Reservoir of Power" id="bcc3-492a-e846-cab3" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time a unit (friendly or enemy) successfully casts a spell while it is within 12&quot; of this **^^Manifestation^^**, give this **^^Manifestation^^** 1 **arcane charge point**.
This **^^Manifestation^^** can have a maximum of 6 **arcane charge points**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Release Arcane Charge" id="de6f-2a80-b2af-97d0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Reaction: You declared a **^^Spell^^** or **^^Unbind^^** ability for a **^^Lumineth Realm-lords Wizard^^** within 3&quot; of this **^^Manifestation^^**</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Add this **^^Manifestation^^**&apos;s **arcane charge points** to the casting roll or unbinding roll. Then, reset this **^^Manifestation^^**&apos;s arcane charge points to 0.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
