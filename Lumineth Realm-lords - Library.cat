          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit&apos;s **Tzul** is a token. After setting up this unit on the battlefield for the first time, place its **Tzul** next to it.
• While this unit&apos;s **Tzul** is next to it, it has **^^Fly^^**.
• While this unit&apos;s **Thyrielle** is on the battlefield, it has **^^Wizard (1)^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="One with the Wind" id="7f0e-1612-ef0d-39c6" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
