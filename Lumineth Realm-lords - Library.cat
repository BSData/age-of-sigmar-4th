                  <profiles>
                    <profile name="Blasted by the Elements" id="aa37-bcef-25c3-7a66" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
