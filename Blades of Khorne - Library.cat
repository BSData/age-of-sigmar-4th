                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: This unit was targeted by a **^^Fight^^** ability.</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a D3. On a 2+, after that **^^Fight^^** ability has been resolved, inflict an amount of mortal damage on the enemy unit using that **^^fight^^** ability equal to the roll.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
