                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">This unit can use **^^Unbind^^** abilities as if it had **^^Wizard (1)^^**. Each time this unit unbinds a spell, subtract 1 from the power level of the **^^Wizard^^** using that **^^Spell^^** ability, to a minimum of 0, for the rest of the battle. An enemy **^^Wizard^^** can be affected by this ability multiple times and the effects are cumulative.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
