          </characteristics>
        </profile>
        <profile name="Reality-Splitting Axe" id="52e9-0e80-9634-d274" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), End of Any Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">This unit can use this ability even if it has been destroyed. Pick an enemy **^^Hero^^** that was allocated any damage points by this unit&apos;s **Axe of Khorne** this turn to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll a dice. On a 5+, the target is automatically destroyed and cannot be replaced for the rest of the battle.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Howl of Blood-Curdling Savagery" id="6507-5dd6-b7c7-20da" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Red</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Movement</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Once Per Battle (Army), Any Combat Phase</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">If this unit is in combat, pick a visible friendly **^^Bloodbound^^** unit that is wholly within 12&quot; of this unit and not in combat to be the target. Then, make a charge roll of 2D6.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">The target can move a distance up to the value of the charge roll. That unit can move through the combat ranges of any enemy units and must end that move within 1/2&quot; of a visible enemy unit. If it does so, the target has charged.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce">**^^Move^^**, **^^Charge^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Mighty Lord of Khorne" id="84b4-280c-695f-f218" hidden="false" import="true" type="model">
