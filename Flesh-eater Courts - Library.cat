            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time you make a delusion roll, you can add 1 or subtract 1 from the roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Glimpse of Delusion" id="510c-b21a-1880-adfd" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a visible enemy model within 18&quot; of this unit to be the target, pick another enemy unit that is visible to the target and within the target&apos;s combat range to be the victim, then make a casting roll of 2D6. You can only pick the target&apos;s unit to be the victim if that unit has 2 or more models.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Pick 1 of the target&apos;s melee weapons. Immediately resolve combat attacks made with that weapon against the victim.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
