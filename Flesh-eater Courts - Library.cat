      <profiles>
        <profile name="Nagash, Supreme Lord of the Undead" id="2296-745c-ef44-6a1e" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic>
