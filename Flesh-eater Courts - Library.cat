                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: You declared the &apos;Counter-charge&apos; command for this unit</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">You and your opponent must roll off. If you roll higher, subtract 3 from the charge roll. If your roll is at least double your opponent&apos;s roll, pick 1 dice in the charge roll instead. Your opponent must remove that dice and use the remaining dice as the charge roll.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
