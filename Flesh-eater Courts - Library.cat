        <profile name="Long Live the King" id="16a1-1bcb-2d3c-012a" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">If this unit would be destroyed, before removing it from play, friendly non-**^^Unique Flesh-eater Courts^^** units wholly within 12&quot; of this unit become enraged until the start of your next turn. Melee weapons used by friendly enraged units have **Crit (Auto-wound)** and score critical hits on unmodified hit rolls of 5+, even if this unit has been destroyed.</characteristic>
          </characteristics>
        </profile>
        <profile name="The King&apos;s Court" id="59b6-3b9e-d5d2-4f83" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Add 1 to the Attacks characteristic of melee weapons used by other friendly non-**^^Monster Flesh-eater Courts Heroes^^** while they are wholly within 12&quot; of this unit. In addition, add 1 to the Attacks characteristic of this unit&apos;s melee weapons for each other friendly non-**^^Monster Flesh-eater Courts Hero^^** wholly within 12&quot; of this unit, to a maximum of +3.</characteristic>
          </characteristics>
        </profile>
      </profiles>
