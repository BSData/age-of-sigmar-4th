                    <profile name="Beloved of the Kingdom" id="b9eb-cb30-0eb5-b5f5" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
