          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Butt of the Lash" hidden="false" id="83f6-495b-d919-7334" publicationId="b765-4747-cddc-385e">
              <profiles>
                <profile name="Butt of the Lash" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="ff19-9ea8-6a4b-bfbd">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Any Combat Phase</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If this unit is wholly within 12&quot; of a friendly **Ma Maegran**, remove this unit from the battlefield and set it up again within her combat range. This unit can only be set up in combat with enemy units that are in combat with the friendly **Ma Maegran**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Orange</attribute>
                    <attribute typeId="6d16-c86b-2698-85a4" name="Type">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="635d-9d29-ca50-914e" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ghyranite Whirlstone" hidden="false" id="dcdb-27e1-8c2a-a98d" publicationId="b765-4747-cddc-385e">
              <profiles>
                <profile name="Ghyranite Whirlstone" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="b2bf-0aa9-33be-5740">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">End of Any Turn</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a visible friendly **^^Matriarch&apos;s Mob^^** unit wholly within 12&quot; of this unit to be the target.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** the target.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Purple</attribute>
