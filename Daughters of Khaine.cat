                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reaction: This unit used the &apos;Activate Place of Power&apos; ability</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Apply the effect below instead of the effect of that &apos;Activate Place of Power&apos; ability. 
Roll a dice. On a 1, inflict D3 mortal damage on this unit. On a 2+, if there are no friendly **Avatars of Khaine** on the battlefield, set up an **Avatar of Khaine** wholly within 12&quot; of this unit, visible to it and more than 9&quot; from all enemy units. This unit has summoned that **^^Manifestation^^**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
