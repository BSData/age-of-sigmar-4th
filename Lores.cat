        <selectionEntry name="Summon Soulstealer Carrion" id="27ce-cb78-3de6-d6de" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d879-7236-2236-0d58" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5573-4470-6e8b-9357" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
