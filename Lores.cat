    <selectionEntryGroup name="Prayer Lore: Ironsunz" id="09e9-b779-14f9-7e0d" hidden="false" publicationId="f860-3305-c15b-0a52">
      <selectionEntries>
        <selectionEntry name="Ghurish Beat" id="9ae7-7f09-915b-2a33" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="436f-2b78-afa3-4cbb" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="56fa-e596-3b41-c7f5" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="436f-2b78-afa3-4cbb" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Ghurish Beat" id="2adb-5471-bfcd-a0be" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Ironsunz Priest^^** to chant this prayer, pick a visible terrain feature within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, enemy units cannot be set up within 9&quot; of the target terrain feature. If the chanting roll was 9+, you can pick 2 eligible terrain features to be the targets instead of 1.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ironsunz Beat" id="3769-cacf-3601-1ebe" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7fff-ed72-ea96-65ee" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="6a51-bd07-7eff-9833" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="7fff-ed72-ea96-65ee" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Ironsunz Beat" id="2902-9f81-76e0-fa4c" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Ironsunz Priest^^** to chant this prayer, pick a visible friendly unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn:
• Add 1 to the Damage characteristic of the target&apos;s melee weapons for attacks that target an enemy unit whose Health characteristic is lower than the target&apos;s.
• Add 1 to the Rend characteristic of the target&apos;s melee weapons for attacks that target an enemy unit whose Health characteristic is the same as or greater than the target&apos;s.
If the chanting roll was 10+, until the start of your next turn, add 1 to the Rend characteristic and Damage characteristic of the target&apos;s melee weapons instead.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Krumpin&apos; Beat" id="c2c5-323d-b86e-c38b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e66b-b29f-7781-fa2a" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="a504-cf2c-6108-2f90" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="e66b-b29f-7781-fa2a" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Krumpin&apos; Beat" id="e63b-7ca8-2ee6-d7fa" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Ironsunz Priest^^** to chant this prayer, pick a visible enemy unit within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Inflict D3 damage on the target. In addition, if the chanting roll was 8+, inflict D3 damage on each enemy unit within 3&quot; of the target.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
