      <selectionEntries>
        <selectionEntry name="Untapped Mutation" id="89cf-0ecc-8fbc-891d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b297-a3fe-eb99-64a4" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="86c5-a167-023b-ad03" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
