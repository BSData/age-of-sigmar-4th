          <profiles>
            <profile name="Choking Mist" id="1abd-510b-e57-abb9" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
