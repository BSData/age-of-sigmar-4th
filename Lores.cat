        <selectionEntry name="These Realms Are Ours" id="b870-b1dc-a64a-636d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3cc3-cdf4-3cf9-df47" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="911d-f844-7871-d94a" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="911d-f844-7871-d94a" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="These Realms Are Ours" id="df5b-6db0-99e2-1d11" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Allies of the Free Cities Wizard^^** to cast this spell, pick an objective within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">For the rest of the turn, melee weapons used by friendly **^^Allies of the Free Cities^^** units have **Charge (+1 Damage)** for attacks that target enemy units that are contesting the target objective.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Spell Lore: Lethis" id="216f-009a-dc34-a0ac" hidden="false" publicationId="dadd-06f0-3f38-c6f3">
