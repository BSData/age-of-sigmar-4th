    <selectionEntryGroup name="Spell Lore: Legions of Nagash" id="cb5d-ff31-ee9e-8994" hidden="false" publicationId="d979-992f-19fa-7e9d">
      <selectionEntries>
        <selectionEntry name="Rise! Rise in My Name!" id="a2f8-2b48-b951-f1cc" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b09c-a6a9-4a73-30b3" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="9695-6986-08b2-d7c9" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="9695-6986-08b2-d7c9" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Rise! Rise in My Name!" id="5f88-9488-fdfc-8ae0" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick each other visible friendly **^^Legions of Nagash^^** unit wholly within 24&quot; of the caster to be the targets, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">If a target unit has a Health characteristic of 1, return 3 slain models to the target unit.
If a target unit has a Health characteristic of 2 or 3, return 1 slain model to the target unit and **Heal (2)** the target unit.
If a target unit has a Health characteristic of 4 or more, **Heal (D6)** the target unit.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="My Undying Demand" id="24c2-1280-5f98-d25f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="04d4-ca6d-b9e6-e644" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="c3d8-d0df-6da8-c13d" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="c3d8-d0df-6da8-c13d" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="My Undying Demand" id="b82b-2869-2f78-d64a" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick the friendly **Nagash** to cast this spell, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Ignore the first damage point that would be allocated to each visible friendly **^^Legions of Nagash^^** unit each phase while it is wholly within 24&quot; of the friendly **Nagash**.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Insanity and Nightmares Made Manifest" id="1686-22a2-5396-5559" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6c8e-c96d-03be-b05b" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="2c44-2e25-36a6-f115" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="2c44-2e25-36a6-f115" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Insanity and Nightmares Made Manifest" id="1f42-1f5b-ddd4-205a" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a friendly **^^Flesh-eater Courts^^** unit and a different friendly **^^Nighthaunt^^** unit that are both wholly within 18&quot; of and visible to the caster and wholly within 12&quot; of each other to be the targets, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, while the targets are wholly within 12&quot; of and visible to each other:
• Add 10 to the **^^Flesh-eater Courts^^** target&apos;s control score.
• Subtract 1 from ward rolls for enemy units while they are in combat with the **^^Nighthaunt^^** target.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Reap a Bloody Tithe" id="c12c-448e-7b42-8170" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b132-b81b-ae18-8767" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="6a53-c4b3-1670-f859" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="6a53-c4b3-1670-f859" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Reap a Bloody Tithe" id="a1ec-7718-af3f-e7bb" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a friendly **^^Soulblight Gravelords^^** unit and a different friendly **^^Ossiarch Bonereapers^^** unit that are both wholly within 18&quot; of and visible to the caster and wholly within 12&quot; of each other to be the targets, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, add 1 to hit rolls for combat attacks made by the **^^Soulblight Gravelords^^** target while it is wholly within 12&quot; of and visible to the **^^Ossiarch Bonereapers^^** target.
In addition, pick 1 of the following effects for the **^^Ossiarch Bonereapers^^** target.
• **Heal (D3)** that unit.
• If that unit has a Health characteristic of 1 or 2, return D3 slain models to it.
• If that unit has a Health characteristic of 3 or more, return 1 slain model to it.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Rivers of Blood and Shallow Graves" id="ae85-2ec0-ea96-0fd1" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d4f7-8143-d3d2-5099" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="a6e6-0ac8-c47f-5e2f" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="a6e6-0ac8-c47f-5e2f" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Rivers of Blood and Shallow Graves" id="f18f-49f7-529f-54f6" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a friendly **^^Flesh-eater Courts^^** unit and a different friendly **^^Soulblight Gravelords^^** unit that are both wholly within 18&quot; of and visible to the caster and wholly within 12&quot; of each other to be the targets, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, add 1 to the Rend characteristic of the friendly **^^Flesh-eater Courts^^** target&apos;s weapons while it is wholly within 12&quot; of and visible to the **^^Soulblight Gravelords^^** target.
In addition, pick 1 of the following effects for the **^^Soulblight Gravelords^^** target.
• **Heal (D3)** that unit.
• If that unit has a Health characteristic of 1 or 2, return D3 slain models to it.
• If that unit has a Health characteristic of 3 or more, return 1 slain model to it.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Delusion and Discipline" id="78f2-73f4-e77a-d476" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d9f1-23f0-71ff-841b" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="7d30-8e2c-07c7-52d2" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="7d30-8e2c-07c7-52d2" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Delusion and Discipline" id="edcb-8852-dbb9-5b3a" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a friendly **^^Ossiarch Bonereapers^^** unit and a different friendly **^^Flesh-eater Courts^^** unit that are both wholly within 18&quot; of and visible to the caster and wholly within 12&quot; of each other to be the targets, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, the **^^Ossiarch Bonereapers^^** target has **^^Ward (5+)^^** while it is wholly within 12&quot; of and visible to the **^^Flesh-eater Courts^^** target.
In addition, pick 1 of the following effects for the **^^Flesh-eater Courts^^** target.
• **Heal (D3)** that unit.
• If that unit has a Health characteristic of 1 or 2, return D3 slain models to it.
• If that unit has a Health characteristic of 3 or more, return 1 slain model to it.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bringing Order to Horror" id="72ae-2591-8c16-b49f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="041f-41e7-c65c-db08" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="40bf-9522-a2d5-1e0a" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="40bf-9522-a2d5-1e0a" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Bringing Order to Horror" id="203b-38fe-0ec6-1bc9" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a friendly **^^Nighthaunt^^** unit and a different friendly **^^Ossiarch Bonereapers^^** unit that are both wholly within 18&quot; of and visible to the caster and wholly within 12&quot; of each other to be the targets, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">The **^^Nighthaunt^^** target can use a **^^Charge^^** ability as if it were your charge phase and even if it is in combat. However, if it does so (regardless of whether it is in combat) and the charge roll is 3 or less, that unit does not count as having charged.
In addition, the **^^Ossiarch Bonereapers^^** target can use a **^^Retreat^^** ability as if it were your movement phase, and for the rest of the turn, it can use **^^Charge^^** abilities even if it used a **^^Run^^** or **^^Retreat^^** ability in the same turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fell Blades and Bloody Fangs" id="cf03-513d-a325-aaac" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4351-4fe8-9842-e392" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="1201-0548-3a0c-89a6" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="1201-0548-3a0c-89a6" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Fell Blades and Bloody Fangs" id="44eb-7bb0-879f-8689" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a friendly **^^Nighthaunt^^** unit and a different friendly **^^Soulblight Gravelords^^** unit that are both wholly within 18&quot; of and visible to the caster and wholly within 12&quot; of each other to be the targets, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, add 1 to the Rend characteristic of the **^^Soulblight Gravelords^^** target&apos;s weapons while it is wholly within 12&quot; of and visible to the **^^Nighthaunt^^** target.
In addition, pick 1 of the following effects for the **^^Nighthaunt^^** target.
• **Heal (D3)** that unit.
• If that unit has a Health characteristic of 1 or 2, return D3 slain models to it.
• If that unit has a Health characteristic of 3 or more, return 1 slain model to it.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Gaze of Nagash" id="b84f-8619-1aef-a156" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="171b-b9a2-0cd8-1c7b" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="fff3-a2c7-619b-c0fc" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="fff3-a2c7-619b-c0fc" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="The Gaze of Nagash" id="a114-d83a-4de2-c7d3" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick the friendly **Nagash** to cast this spell. Then, pick 2 points on the battlefield within 18&quot; of and visible to him and within 12&quot; of each other, Then, draw a line between those points, Each visible enemy unit the line passes across is a target. Then, make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Pick **normal gaze** or **empowered gaze**.
If you picked **normal gaze**, inflict D3 mortal damage on each target.
If you picked **empowered gaze**, make an empowerment roll of 2D6. On a 6+, the roll succeeds, otherwise, the roll fails. You can keep making empowerment rolls until a roll fails. If an empowerment roll fails, the spell fails and its effect is not resolved. Otherwise, inflict D3+**X** mortal damage on each target, where **X** is the number of empowerment rolls that succeeded.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Lore of the Spirit-Song" id="6bc6-365e-5b6d-2b9a" hidden="false" publicationId="61ee-fae0-f1da-2591">
      <selectionEntries>
        <selectionEntry name="Song Of The Lost" id="e842-cdb7-4e22-fe80" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="243c-bfe2-d0fb-d9fc" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="f979-5b0d-7f34-1888" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="243c-bfe2-d0fb-d9fc" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Song Of The Lost" id="a865-102f-ce95-480c" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sylvaneth Priest^^** to chant this prayer, pick a friendly **^^Sylvaneth^^** unit that is wholly within the **creeping overgrowth** or that is visible to them and wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, subtract 1 from wound rolls for attacks that target that friendly unit. In addition, if the chanting roll was 8+, pick 1 of the following effects:
• You can **Heal (3)** the target.
• If the target is not a **^^Monster^^**, ignore modifiers to save rolls for the target (positive and negative) until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Song Of Dread" id="0734-e226-1b46-3b75" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6ac8-dca8-cfea-0f5a" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="50ad-564b-d3a8-ca2d" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="6ac8-dca8-cfea-0f5a" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Song Of Dread" id="4c37-4bd5-f9d5-170a" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sylvaneth Priest^^** to chant this prayer, pick an enemy unit that is wholly within the **creeping overgrowth** or that is visible to them and within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 8+, you can pick another eligible unit to be a second target. Until the start of your next turn, each time a target uses a **^^Move^^** ability and ends that move within the **creeping overgrowth**, inflict D3 mortal damage on the target after that **^^Move^^** ability has been resolved.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Song Of War" id="a51d-684b-100f-2fe5" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="981e-8303-1fb0-ea60" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="5b9b-7250-c24e-cfcb" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="981e-8303-1fb0-ea60" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Song Of War" id="1b5b-a2e8-6dd3-17fb" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sylvaneth Priest^^** to chant this prayer, pick a friendly **^^Sylvaneth^^** unit that is wholly within the **creeping overgrowth** or that is visible to them and wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 10+, you can pick another eligible unit to be a second target. Until the start of your next turn, add 1 to the Rend characteristic of the target(s) melee weapons.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Prayer Lore: Lords of the Clan" id="95d5-8fcc-168c-1851" hidden="false" publicationId="61ee-fae0-f1da-2591">
      <selectionEntries>
        <selectionEntry name="Song of Persistence" id="b213-6ea7-a621-ddb2" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="278f-678e-b64d-5e2e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="6261-4743-ff61-c3f4" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="6261-4743-ff61-c3f4" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Song of Persistence" id="2f36-93d6-0ab3-ccd5" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Lords of the Clan Priest^^** to chant this prayer, pick a friendly **^^Lords of the Clan Monster^^** that is wholly within the creeping overgrowth or that is visible to them and wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, ignore the effect of the &apos;Battle Damaged&apos; ability on the target. In addition, if the chanting roll was 6+, the target has **^^Ward (6+)^^** until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Spell Lore: Lords of the Clan" id="48ab-4fb5-f842-aeb8" hidden="false" publicationId="61ee-fae0-f1da-2591">
      <selectionEntries>
        <selectionEntry name="Call Forth the Forest" id="c532-a7ba-ae55-6151" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c56e-ddef-c981-b2e6" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="59a6-e68c-0910-d9f4" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="59a6-e68c-0910-d9f4" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Call Forth the Forest" id="a297-cb51-4b37-c343" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Lords of the Clan Wizard^^** to cast this spell, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">If there are fewer than 9 friendly **Awakened Wyldwoods** on the battlefield, you can set up an **Awakened Wyldwood** wholly within 24&quot; of the caster, more than 3&quot; from all objectives and more than 1&quot; from all enemy units and other terrain features. If there are 9 or more friendly **Awakened Wyldwoods** on the battlefield, **Heal (3)** each friendly **Awakened Wyldwood** instead.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
