                <characteristic name="Casting Value" id="18ee-5197-bd17-3998" hidden="false" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" id="7223-ce52-5798-8285" hidden="false" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Scions of Nulahmia Wizard^^** to cast this spell, pick a visible friendly **Dire Wolves** or **Fell Bats** unit wholly within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" id="72c5-a165-31e0-5f85" hidden="false" typeId="1cb9-a-1345-907f">You can return 1 slain model to that unit.</characteristic>
                <characteristic name="Keywords" id="2475-26c4-70f3-73a1" hidden="false" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
