    <selectionEntryGroup name="Spell Lore: Wardens of the Chorrileum" id="92cb-8663-1f13-dfe3" hidden="false" publicationId="9866-239b-07f0-d92b">
      <selectionEntries>
        <selectionEntry name="Slipstream" id="e86b-c121-1c73-433a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8364-a3b5-d7e6-b4dd" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="1699-445c-de38-73d6" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="8364-a3b5-d7e6-b4dd" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Slipstream" id="c487-0a33-42d4-b103" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Chorrileum Wizard^^** to cast this spell, pick a visible friendly **^^Chorrileum^^** unit that is not in combat and is wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">The target can move up to D6&quot;. That move cannot pass through or end within the combat range of an enemy unit.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Essence of the Chorrileum" id="20de-0b7f-a567-6b3a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fa71-9c07-9c3e-6961" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="b40d-2ff0-7178-c6bf" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="fa71-9c07-9c3e-6961" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Essence of the Chorrileum" id="5d22-c1aa-bff4-a4d5" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Chorrileum Wizard^^** to cast this spell, pick a visible friendly **^^Chorrileum^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">If the target is **^^Namarti^^**, you can return D6 slain models to it. Otherwise, **Heal (D3)** the target.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Lore of Wyrdflame" id="3c55-2351-8a06-cef0" hidden="false" publicationId="8b18-3cdd-0e4a-bfd4">
      <selectionEntries>
        <selectionEntry name="Flaming Weapon" id="f85a-ab0a-fdbb-8d88" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="aa59-8834-46ef-1cae" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="8e5f-b0c8-ef62-a08d" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="8e5f-b0c8-ef62-a08d" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Flaming Weapon" id="ed2c-2006-0839-ee3b" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">4</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Pyrofane Wizard^^** to cast this spell, pick a visible friendly **^^Hero^^** wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Add 1 to the Damage characteristic of the target&apos;s melee weapons until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Burning Anguish" id="dc9b-24e5-c6d3-2b9b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f5cd-48ec-1684-9176" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="c42e-909a-0b06-c30d" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="c42e-909a-0b06-c30d" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Burning Anguish" id="1657-3630-6a97-def0" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Pyrofane Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them and which had any damage points allocated to it this battle round by the &apos;Immolation of the Realms&apos; ability to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">The target cannot use commands for the rest of the battle round.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Summon Cult Leader" id="6f44-7029-5090-2b21" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="50e5-7183-0127-9caf" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="f296-9c38-4f2d-730b" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
