      <selectionEntries>
        <selectionEntry name="Febrile Advance" id="53f9-7bf0-fbce-5bfe" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="099d-5705-a2cd-bb2f" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="f225-122c-9aa7-3825" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
