      <selectionEntries>
        <selectionEntry name="Summon Foot of Gork" id="485e-b60d-7af3-32f2" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="787f-90eb-db80-87f2" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="1b90-b15b-a0f1-564c" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="787f-90eb-db80-87f2" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Summon Foot of Gork" id="6bfb-eaca-dca6-259b" hidden="false" publicationId="8b1b-f2c7-890e-2bbe" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">If there is not a friendly **Foot of Gork** on the battlefield, pick a friendly **^^Kruleboyz Wizard^^** to cast this spell, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Set up a **Foot of Gork** wholly within 12&quot; of the caster, visible to them and more than 9&quot; from all enemy units. A **Foot of Gork** has 2 parts that must be set up within 9&quot; of each other.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Summon^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Prayer Lore: The Duardin Ascendant" id="53aa-2e28-4daa-9e3e" hidden="false" publicationId="e47d-cde6-bbd2-9db9">
      <selectionEntries>
        <selectionEntry name="Oath of Restoration" id="fbc3-eeaf-d98d-53b0" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bb48-9eb8-c372-e313" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="0242-8301-7e62-c936" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="bb48-9eb8-c372-e313" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Oath of Restoration" id="e850-96a2-4b32-ff02" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143"/>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3"/>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">
Pick a friendly **^^Duardin Ascendant Priest^^** to chant this prayer, pick a visible objective within 18&quot; of them that is coned by 2 or more friendly **unified** units to be the target, then make a chanting roll of D6.                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="d1f3-921c-b403-1106" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="lessThan" value="1"/>
                        <condition childId="376a-6b97-8699-dd59" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, friendly **^^Duardin Ascendant^^** units have **^^Ward (6+)^^** while they have any models contesting the target. If the chanting roll was 7+, friendly **^^Duardin Ascendant^^** models have **^^Ward (5+)^^** while they have any models contesting the target instead.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Spirit of the White Dwarf" id="3190-b938-acdb-f988" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d2c2-9370-e632-96e8" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="d3e6-ee94-c3ea-3c70" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="d2c2-9370-e632-96e8" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Spirit of the White Dwarf" id="c992-4e49-7af2-4bf9" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143"/>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3"/>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Duardin Ascendant Priest^^** to chant this prayer, pick a visible friendly **^^Duardin Ascendant^^** unit within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">The target is **unified** until the start of your next turn. If the chanting roll was 8+, you can pick 2 targets instead of 1.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Lore of the Twisted Wilds" id="c4da-6f3d-a13d-c576" hidden="false" publicationId="3cc2-31d3-9dd2-f858">
      <selectionEntries>
        <selectionEntry name="Devolve" id="bcd2-36fc-3817-dd29" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="adbd-e631-d212-e532" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="a655-6cb0-137e-e0d2" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="adbd-e631-d212-e532" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Devolve" id="6e4c-7fa2-52be-998c" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Beasts of Chaos Wizard^^** to cast this spell, pick a visible enemy non-**^^Hero^^** unit within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn:
• The target unit has a maximum control score of 1.
• The target cannot use commands.
• Each time the target moves, if the caster is on the battlefield, the target must end that move no further from the caster than it was at the start of the move.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vicious Stranglethorns" id="19f0-7157-940f-3084" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2db1-9268-ae31-bc47" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="d799-7571-3ebb-2d58" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="2db1-9268-ae31-bc47" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Vicious Stranglethorns" id="5394-f529-76a8-18b5" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">8</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Beasts of Chaos Wizard^^** to cast this spell, pick a visible enemy unit within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn:
• Halve the target&apos;s Move characteristic.
• Subtract 1 from the number of dice rolled when making charge rolls for the target, to a minimum of 1.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Viletide" id="31f7-16a1-3229-6e91" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d0d6-91ba-df37-8b93" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="a71f-2bad-7911-33c6" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="d0d6-91ba-df37-8b93" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Viletide" id="9e2d-9462-78e4-4505" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Beasts of Chaos Wizard^^** to cast this spell, pick a visible enemy unit within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict D3 mortal damage on the target. In addition, until the start of your next turn, the target cannot use commands.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
