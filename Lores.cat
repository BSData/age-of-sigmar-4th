      <selectionEntries>
        <selectionEntry name="Shifting Manifestations" id="8c50-7e40-f647-efc5" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2f1a-5534-7e21-2251" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="d068-8e00-7a3c-8f5e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
