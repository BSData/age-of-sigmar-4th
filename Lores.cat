    <selectionEntryGroup name="Spell Lore: The Roving Maw" id="cffe-2c38-41e3-3328" hidden="false" publicationId="1ac6-e227-a186-12">
      <selectionEntries>
        <selectionEntry name="Mawmeat" id="c160-a9a5-406c-811a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8247-6dbb-46cf-2a71" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="f552-315c-432b-50a4" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="8247-6dbb-46cf-2a71" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Mawmeat" id="d1c3-e079-91c0-d46b" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Roving Maw Wizard^^** to cast this spell, pick a visible terrain feature within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">For the rest of the battle, units on or within 1&quot; of the target are **vulnerable to Mawpits**. This ability has no effect on **^^Roving Maw^^** units or units that have **^^Fly^^**.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Retcher" id="7b3d-3970-fb49-61b3" hidden="false" import="true" type="upgrade">
          <constraints>
