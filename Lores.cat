        <selectionEntry name="Summon Wrath-axe" id="c361-1cd4-59de-5751" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dcb2-18f0-fa4f-96a8" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
