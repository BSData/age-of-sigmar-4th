          </modifiers>
          <profiles>
            <profile name="Right Gitz in da Right Place" id="d5ba-836a-d610-fc03" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd"/>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^King&apos;s Gitz Wizard^^** to chant this prayer, pick a visible friendly unit wholly within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">The target&apos;s weapons have **Anti-^^Hero^^ (+1 Rend)** until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Da Loonking&apos;s Command" id="426f-7f9e-23cc-0e43" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="96de-d62b-146e-9a5b" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="3fb4-3f5f-a1af-2dc9" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
