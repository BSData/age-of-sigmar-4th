    <selectionEntryGroup name="Prayer Lore: The Iron March" id="22a4-0e5b-5941-9a4b" hidden="false" publicationId="a746-732d-1a22-460">
      <selectionEntries>
        <selectionEntry name="The Chant of Iron" id="5088-105f-b442-385e" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f72e-c194-55c5-ce44" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="ef40-c009-90d6-84d9" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="ef40-c009-90d6-84d9" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="The Chant of Iron" id="ebff-23bf-6d74-98e3" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Iron March Priest^^** to chant this prayer, pick either a visible enemy unit within 18&quot; of them or a visible friendly **^^Iron March^^** unit that is wholly within 12&quot; of them and that has not been picked to be the target of this ability this turn to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If you picked an enemy unit:
• If the chanting roll was 8+, you can pick another eligible enemy unit to be a second target.
• Subtract 2&quot; from each target&apos;s Move characteristic until the start of your next turn.
If you picked a friendly target, **Heal (D3)** the target and the chanter. IF the chanting roll was 8+, **Heal(D3)** each visible friendly **^^Iron March^^** unit that is wholly within 12&quot; of the chanter and that has not been healed by this ability this turn instead.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Prayer Lore: Allies of the Free Cities" id="8a52-9761-c4a1-e756" hidden="false" publicationId="a746-732d-1a22-460">
      <selectionEntries>
