            <profile name="Bash &apos;Em, Ladz" id="ea0c-5e7-77ba-167d" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Ironjawz Wizard^^** to cast this spell, pick a visible friendly **^^Ironjawz^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">The target&apos;s melee weapons have **Crit (2 Hits)** until the start of your next turn</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Da Great Big Green Hand of Gork" id="0f36-4605-74ec-d7f8" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="84fe-2b41-0d0b-1fa9" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5371-fe11-0cf1-016d" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
