    <selectionEntryGroup name="Lore of Extravagance" id="a740-8833-9146-5ead" hidden="false" publicationId="95fc-e96f-a916-bba1">
      <selectionEntries>
        <selectionEntry name="Last Ecstasy" id="43cf-5ae5-4f8b-79c0" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="67d8-6e02-ce76-b649" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="96a6-f71a-99b2-13cb" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="96a6-f71a-99b2-13cb" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Last Ecstasy" id="a251-5fee-b20e-1402" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Hedonites of Slaanesh Wizard^^** to cast this spell, pick a visible friendly **^^Hedonites of Slaanesh^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, each time a modoel in the target unit is slain by a combat attack and that model was in combat with the attacking unit, roll a dice. If the target unit is a **^^Monster^^**, roll 10 dice instead. For each 4+, inflict 1 mortal damage on the attacking unit after the **^^Fight^^** ability has been resolved.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Overwhelming Acquiescence" id="3627-4b2a-6812-1b25" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e1dd-46d4-1a1c-5b72" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="fb4d-d34e-a871-f9ce" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="fb4d-d34e-a871-f9ce" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Overwhelming Acquiescence" id="4e7-3bd0-b982-e2ac" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Hedonites of Slaanesh Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Unit the start of your next turn, weapons used by friendly **^^Hedonites of Slaanesh^^** units for attacks that target that enemy unit, including **Companion** weapons, have **Crit (2 Hits)**.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hysterical Frenzy" id="6239-cfbb-c6ac-c762" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bfc1-6259-7730-6e69" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="840d-e536-7164-2eea" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="840d-e536-7164-2eea" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Hysterical Frenzy" id="90b7-4f61-a98c-ffc1" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
                <attribute name="Type" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Hedonites of Slaanesh Wizard^^** to cast this spell, pick a friendly **^^Hedonites of Slaanesh^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Add 1 to wound rolls for the target&apos;s combat attacks until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
