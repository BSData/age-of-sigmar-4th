    <selectionEntryGroup name="Prayer Lore: The Great-grand Gnawhorde" id="7e4e-627b-7b7c-2cb6" hidden="false" publicationId="ff83-b049-91b9-ed05">
      <selectionEntries>
        <selectionEntry name="Reverberating Ritual" id="1156-a529-01f6-9da6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="46f7-0870-8d47-851c" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d2c0-c8e0-67c6-b793" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
