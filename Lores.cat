            <profile name="Summon Wrath-axe" id="bc09-7f88-3048-f9fa" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">If there is not a friendly **Wrath-axe** on the battlefield, pick a friendly **^^Blades of Khorne Priest^^** to chant this prayer, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Set up a **Wrath-axe** wholly within 12&quot; of the chanter, visible to them and more than 9&quot; from all enemy units.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Summon^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Prayer Lore: New Summercourt" id="0576-69cc-8ee8-20ba" hidden="false" publicationId="6281-1a88-8f4-946">
      <selectionEntries>
        <selectionEntry name="Excommunication" id="a1cd-f3e1-7036-c7e3" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5eeb-7cff-9070-50bb" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="2336-0b28-6fea-74f6" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="5eeb-7cff-9070-50bb" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Excommunication" id="08cd-c235-b39c-7408" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Flesh-eater Courts Priest^^** to chant this prayer, pick a visible enemy unit within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, ignore positive modifiers to save rolls for the target. In addition, if the chanting roll was 10+, ward rolls cannot be made for the target until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Spell Lore: New Summercourt" id="a5f7-948d-67a4-f032" hidden="false" publicationId="6281-1a88-8f4-946">
      <selectionEntries>
        <selectionEntry name="Deranged Transformation" id="0da3-3a92-3dd1-f016" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c067-8afa-8719-22ab" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="870b-f828-b548-64b6" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
