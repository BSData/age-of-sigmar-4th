              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Slaves to Darkness Wizard^^** to cast this spell, pick a visible enemy unit within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">The target has **^^Strike-last^^** until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Daemonic Speed" id="4756-4114-0582-1abb" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e7d5-c8ba-4321-3ea0" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="4653-5ca1-ae16-78dd" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
