        <selectionEntry name="Shield of Fate" id="fbfd-1702-fb81-593d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a6c3-b9ac-3945-5e2d" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="cc94-ce03-5168-1d5a" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
