        <selectionEntry name="Manifestations of Murder" id="9f7e-98c1-6786-dd15" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="add1-7273-8583-7f83" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="c9aa-1867-15be-fb34" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
