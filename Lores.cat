            <constraint id="f044-8d66-73fa-1552" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="a4d0-b547-26dd-edd5" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="f044-8d66-73fa-1552" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Curse of Scorched Metal" id="2e13-d3dd-9a26-e85" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
                <attribute name="Type" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Cities of Sigmar Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, the first time the target uses an **^^Attack^^** ability, for each unmodified hit roll of 1 for an attack made by the target as part of that **^^Attack^^** ability, inflict 1 mortal damage on the target after that **^^Attack^^** ability has been resolved.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="High Star&apos;s Light" id="ded1-658e-a888-2de9" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8364-7100-3a17-8eda" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="be15-2d27-fe4e-5279" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
