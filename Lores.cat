            <constraint id="df8b-0114-4781-4d30" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="ded8-33d3-1944-d881" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
