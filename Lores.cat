              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry name="Soul-Claim" id="f57a-2fb6-f908-0e05" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0b4d-6d22-561a-4bc6" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="81c7-4e90-4b9b-7ed7" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="0b4d-6d22-561a-4bc6" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Soul-Claim" id="047b-ed3b-50d5-ed28" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Ossiarch Bonereapers Wizard^^** to cast this spell, then pick a visible enemy unit within 18&quot; of them to be the enemy target. Then, you can pick a visible friendly **^^Ossiarch Bonereapers^^** unit wholly within 12&quot; of that **^^Wizard^^** to be a friendly target. Then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict D3 mortal damage on the enemy target. If any models are slain by this ability, pick 1 of the following:
• **Heal (3)** the friendly target.
• Return a number of slain models to the friendly target with a combined Health characteristic of up to 3.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bolster Creation" id="c7ca-8018-fae0-167f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="403d-8448-3c74-6d07" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="8d8e-f590-94d2-7f2c" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="403d-8448-3c74-6d07" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Bolster Creation" id="b6ed-5730-b51b-f854" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Ossiarch Bonereapers Wizard^^** to cast this spell, pick a visible friendly **^^Ossiarch Bonereapers^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, ignore the first damage point allocated to the target in each phase.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Invigorate the Ranks" id="1870-b93b-0625-e6aa" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f544-26bf-18ea-95fd" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="d5d8-6535-3ce0-437a" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="f544-26bf-18ea-95fd" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Invigorate the Ranks" id="4c50-9282-42ae-9dcf" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Ossiarch Bonereapers Wizard^^** to cast this spell, pick a visible friendly **^^Ossiarch Bonereapers^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Add 1 to the Attacks characteristic of the target&apos;s melee weapons until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
