          <profiles>
            <profile name="Febrile Advance" id="caa6-e471-2105-e1d4" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Maggotkin of Nurgle Priest^^** to chant this prayer, pick a visible friendly **^^Maggotkin of Nurgle^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 6+, you can pick another eligible unit to be a second target. Until the start of your next turn, add 3&quot; to the distance each target can move when making pile-in moves.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Blunting Blight" id="895f-c448-aeb8-15b1" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="286a-4dd1-6ef4-7e33" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="2c09-0679-000d-c0de" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="286a-4dd1-6ef4-7e33" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Blunting Blight" id="4d64-5b7f-b19f-b543" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Maggotkin of Nurgle Priest^^** to chant this prayer, pick a visible enemy unit within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 10+, you can pick another eligible unit to be a second target. Until the start of your next turn, the targets&apos; attacks cannot score critical hits (treat them as regular hits instead).</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Agonising Vomiting" id="538a-0ea5-889b-124f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="463d-fafd-73d5-b514" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="d834-f612-ceb8-31eb" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
