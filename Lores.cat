                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Big Waaagh! Priest^^** to chant this prayer, pick a visible friendly non-**^^Hero Big Waaagh! Infantry^^** unit that is in combat and wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">The target can use 2 **^^Fight^^** abilities this turn. After the first is used, however, the target has **^^Strike-last^^** for the rest of the turn. If the chanting roll was 10+, you can pick another eligible unit to be a second target.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Manifestation Lore: Big Waaagh!" id="5ba8-6290-d9f6-b4ec" hidden="false" publicationId="8b1b-f2c7-890e-2bbe">
      <entryLinks>
        <entryLink name="Foot of Gork" id="ed28-6582-482f-ed2c" hidden="false" import="true" targetId="6cc6-3227-bf8d-1a1d" type="selectionEntry">
