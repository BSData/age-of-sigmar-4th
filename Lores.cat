              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Deafening Frenzy" id="49d3-c1e0-74f7-0c51" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
