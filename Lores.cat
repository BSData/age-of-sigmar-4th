              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Catechism of Murder" id="a2fe-655d-a868-0f44" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Daughters of Khaine Priest^^** to chant this prayer, pick a visible friendly **^^Daughters of Khaine^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">The target&apos;s melee weapons have **Crit (Auto-wound)** until the start of your next turn. In addition, if the chanting roll was 7+, the target&apos;s combat attacks score critical hits on unmodified hit rolls of 5+ until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Dance of Doom" id="bfec-2e5d-9071-60d6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="229d-e2fb-bd68-7814" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="1645-fceb-7417-1ddf" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
