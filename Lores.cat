                <characteristic name="Declare" id="f006-8169-bb02-f9e" hidden="false" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Scions of Nulahmia Wizard^^** to cast this spell.</characteristic>
                <characteristic name="Effect" id="261-84c6-930b-d6f2" hidden="false" typeId="1cb9-a-1345-907f">For the rest of the turn, add 1 to the Attacks characteristic of melee weapons used by friendly **^^Scions of Nulahmia Vampire^^** units while they are wholly within 12&quot; of the caster.</characteristic>
                <characteristic name="Keywords" id="d92b-9a2d-12dc-27f2" hidden="false" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
