          </modifiers>
          <profiles>
            <profile name="Siphon Strength" id="8690-b105-f962-5f39" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
