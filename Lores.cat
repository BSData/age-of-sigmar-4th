    </selectionEntryGroup>
    <selectionEntryGroup name="Lore of the Overgrown Wilds" id="837c-c71b-823c-0ce8" hidden="false" publicationId="836f-b899-80c0-0f72">
      <selectionEntries>
        <selectionEntry name="Thicket Shield" id="5cf6-3520-badf-ebeb" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a45a-39b5-1bed-0364" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Thicket Shield" id="7e55-fe18-6301-602c" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a visible friendly unit wholly within 12&quot; of them and not in combat to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, while the target is wholly within 3&quot; of a terrain feature, it is not visible to enemy units more than 9&quot; away.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Awaken the Carnivores" id="8d62-ec5d-e510-f902" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2cca-cac3-fe0a-a32c" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Awaken the Carnivores" id="3137-3e69-e143-1cbb" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a visible terrain feature within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, subtract 1 from save rolls (friendly and enemy) while they are within 3&quot; of the target.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Disrupt the Humours" id="65fa-0276-0249-0e0a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a0a6-00e2-743d-1e1d" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Disrupt the Humours" id="9119-c34e-2c17-d5ab" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, subtract 1 from contamination rolls and remediation rolls for the target.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Shifting Lands" id="15a3-ffcb-1521-f494" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1a69-d3c2-3d4c-22f0" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Shifting Lands" id="957b-0424-84a6-8d30" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a visible terrain feature within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, enemy units cannot be set up within 12&quot; of the target as a result of an enemy ability.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Healing Spiral" id="1d03-cb07-a139-d11a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="600d-1915-3ba3-6a5c" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Healing Spiral" id="d3a5-6623-5eab-5c12" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, pick a visible friendly unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, each time the target uses a **^^Fight^^** ability, after that ability has been resolved, **Heal(X)** the target, where **X** is the number of enemy models slain by combat attacks as part of that **^^Fight^^** ability.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Forest Walk" id="0c23-22da-65b6-fcb0" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d707-143b-7106-ff1f" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Forest Walk" id="80b0-c88e-9abf-984b" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Wizard^^** to cast this spell, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Double the caster&apos;s Move characteristic until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Prayers of the Jade Soul" id="4696-4eef-82a6-4222" hidden="false" publicationId="836f-b899-80c0-0f72">
      <selectionEntries>
        <selectionEntry name="Spring in Their Step" id="16b0-44a2-8e10-7dcb" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a356-8cb0-6f7b-9cfd" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Spring in Their Step" id="d0d1-abb1-6be2-9405" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Priest^^** to chant this prayer, pick a visible terrain feature within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, add 1 to charge rolls for friendly units while they are within 3&quot; of the target. If the chanting roll was 6+, add 2 to charge rolls for those units instead of 1.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Rooted Delusion" id="076a-47b0-a4fa-c6b6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="36d5-46bc-5be0-9928" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Rooted Delusion" id="12d4-825c-30a6-65b3" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Control</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Priest^^** to chant this prayer, pick a visible enemy unit within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, the target has **^^Strike-last^^**. In addition, if the chanting roll was 6+, subtract 1 from wound rolls for the target&apos;s attacks until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Jade Revival" id="9097-17c0-3f80-772c" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a165-4119-83ca-f9b6" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Jade Revival" id="2437-7c0b-239a-3971" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Rallying</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Priest^^** to chant this prayer, pick a visible friendly unit that is not in combat and is wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Return a number of slain models to the target unit with a combined Health characteristic of up to 4. If the chanting roll was 8+, return a number of slain models to the target with a combined Health characteristic of up to 8 instead.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Regenerating Blossom" id="bfdb-d7e3-3767-b4d9" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="47cc-b878-8aba-b1eb" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Regenerating Blossom" id="d058-1ad4-ee9a-0a4c" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Priest^^** to chant this prayer, pick a visible terrain feature within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">**Heal (D3)** each unit (friendly and enemy) within 3&quot; of the target. If the chanting roll was 8+, **Heal (3)** each unit (friendly and enemy) within 3&quot; of the target instead.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Angry Wilds" id="d5c8-5e36-c7c1-0dd8" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="587b-b2af-b8b9-de0b" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="The Angry Wilds" id="bab2-2dbf-a871-97ac" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Priest^^** to chant this prayer, pick a visible enemy unit within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, each time your opponent declares a command for the target, unless they spend 1 additional command point to use that command, the command has no effect, it still counts as having been used, and the command points spent to use the command are still lost. If the chanting roll was 10+, the target cannot use commands until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Soporific Soothing" id="5ee0-a9a9-3a61-4e66" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="38dc-a8fb-548a-e567" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Soporific Soothing" id="9bdd-71ab-4f78-7955" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Priest^^** to chant this prayer, pick a visible enemy unit within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, the target&apos;s attacks cannot score critical hits (treat them as regular hits instead). In addition, if the chanting roll was 9+, combat attacks that target that enemy unit score critical hits on unmodified hit rolls of 5+.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Lore of Virulence" id="242a-210c-e7cd-fae0" hidden="false" publicationId="9c71-86cb-e1d0-ec8d">
      <selectionEntries>
        <selectionEntry name="Bloated with Sickness" id="a034-d984-8d81-6e20" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ca7b-c4db-f7d4-84a6" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="259c-08e3-554d-a28e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="ca7b-c4db-f7d4-84a6" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Bloated with Sickness" id="66fa-209c-4c5b-3091" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Maggotkin of Nurgle Priest^^** to chant this prayer, pick a visible friendly non-**^^Monster Maggotkin of Nurgle^^** unit wholly within 12&quot; of the chanter to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, ignore the first damage point that would be allocated to the target in each phase, If the chanting roll was 10+, you can pick another eligible unit to be a second target.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gift of Disease" id="9075-6fd4-b752-adfc" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="77b0-e81e-7ef8-d482" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="ddd4-ee65-07d0-f428" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="77b0-e81e-7ef8-d482" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Gift of Disease" id="b513-30b2-8c37-7cdd" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Maggotkin of Nurgle Priest^^** to chant this prayer, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, subtract 1 from wound rolls for attacks made by enemy units while they are in combat with the chanter. In addition, if the chanting roll was 10+, each enemy unit in combat with the chanter, excluding **^^Manifestations^^** and terrain features, has the **^^Diseased^^** keyword.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Favoured Poxes" id="c6d5-3d5c-af97-d068" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d3c3-7cb7-2549-a66c" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="5c5d-a14a-33a9-9637" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="d3c3-7cb7-2549-a66c" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Favoured Poxes" id="d3cc-7d13-9877-5a3b" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Maggotkin of Nurgle Priest^^** to chant this prayer, pick a visible enemy unit within 18&quot; of the chanter to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, subtract 2 from charge rolls for the target, If the chanting roll was 10+, subtract 1 from the number of dice rolled when making charge rolls for the target, to a minimum of 1, instead.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Spell Lore: Cycle of Corruption" id="4a33-ee57-b73f-c585" hidden="false" publicationId="9c71-86cb-e1d0-ec8d">
      <selectionEntries>
        <selectionEntry name="Epidermal Crustitis" id="7e59-7236-2c72-8d82" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1b9d-fb89-ac2f-3e36" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="2de4-7ddf-a68f-bd77" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="2de4-7ddf-a68f-bd77" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Epidermal Crustitis" id="cd25-326f-c295-ff37" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Cycle of Corruption Wizard^^** to cast this spell, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, subtract 1 from the Damage characteristic of melee weapons used for attacks that target the caster.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Rank and Vile" id="6543-8867-9e80-f473" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dfd1-f42d-542a-8cf7" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4900-6b75-082b-26d1" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="4900-6b75-082b-26d1" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Rank and Vile" id="3425-1ea6-cb6b-4c69" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Rallying</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Cycle of Corruption Wizard^^** to cast this spell, pick a visible enemy **^^Infantry^^** unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, each time a model in the target unit is slain, after removing it from the battlefield, roll a dice. On a 4+, return 1 slain model to a friendly non-**Hero Cycle of Corruption^^** unit within 6&quot; of the target.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Spittledrain" id="41e8-23be-a872-4989" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="35c8-db38-33b5-8b79" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="e436-b983-bb7f-35af" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="e436-b983-bb7f-35af" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Spittledrain" id="404f-a8cd-971f-1720" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Cycle of Corruption Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Subtract 1 from the target&apos;s Move characteristic until the start of your next turn. Then, roll a number of dice equal to the number of models in the target unit. For each 6, inflict 1 mortal damage on the target, to a maximum of 7.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Prayer Lore: Cycle of Corruption" id="daef-a569-46bd-96ef" hidden="false" publicationId="9c71-86cb-e1d0-ec8d">
      <selectionEntries>
        <selectionEntry name="Bacterial Blessing" id="5de8-da05-c578-ecfe" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a421-60c1-3a24-97b7" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="89e7-33fc-2d0b-72be" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="89e7-33fc-2d0b-72be" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Bacterial Blessing" id="1397-6898-4635-659c" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Cycle of Corruption Priest^^** to chant this prayer, pick a visible friendly **^^Cycle of Corruption^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, add 1 to wound rolls for the target&apos;s combat attacks. If the chanting roll was 7+, you can pick another eligible unit to be a second target.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ever Turning" id="842e-53e4-7eea-959e" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0e09-3918-5193-0734" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4a0e-bf78-59ba-7e61" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="4a0e-bf78-59ba-7e61" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Ever Turning" id="aeb1-34fd-2204-83dc" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Cycle of Corruption Priest^^** to chant this prayer, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">The next **^^Cycle^^** ability in the sequence is ripe for the rest of the battle round instead of the current **^^Cycle^^** ability. If the chanting roll was 12+, you can pick which **^^Cycle^^** ability is ripe.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virulent Agonies" id="a281-984d-b324-e956" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9854-8fe2-e036-c8ef" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="22a9-1454-fbe0-58d1" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="22a9-1454-fbe0-58d1" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Virulent Agonies" id="8884-ea73-fa5e-97ee" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Cycle of Corruption Priest^^** to chant this prayer, pick a visible enemy unit within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Inflict 1 mortal damage on the target. Then, inflict 1 mortal damage on each other enemy unit within the target&apos;s combat range, If the chanting roll was 7+, inflict D3 mortal damage on the target instead of 1.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Spell Lore: The Gardeners of Nurgle" id="2f4b-b1ad-bb4e-16ed" hidden="false" publicationId="9c71-86cb-e1d0-ec8d">
      <selectionEntries>
        <selectionEntry name="Munificent Blights" id="1f86-5be8-ae74-d09d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="122d-6227-1eb9-144b" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="733f-2014-c3e0-2b49" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="733f-2014-c3e0-2b49" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Munificent Blights" id="2541-76c8-f713-3af6" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Gardeners of Nurgle Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, add 1 to the amount of mortal damage inflicted on the target by the &apos;Putrescent Sap&apos; ability.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Scumfall" id="7e61-840a-79c7-af60" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="be80-4806-5b78-5030" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="7d92-66bf-fe2a-64d8" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="7d92-66bf-fe2a-64d8" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Scumfall" id="e20a-a289-51e5-eb20" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Gardeners of Nurgle Wizard^^** to cast this spell, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, friendly **^^Gardeners of Nurgle^^** units that are wholly within 12&quot; of a friendly **Feculent Gnarlmaw** are not visible to units more than 9&quot; away.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Canopy of Virulence" id="281b-f643-0794-8ce6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bd71-c92a-bda6-3c6f" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5cc1-1d40-13c3-7987" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="5cc1-1d40-13c3-7987" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Canopy of Virulence" id="f801-cc77-420e-53be" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Gardeners of Nurgle Wizard^^** to cast this spell, pick a visible friendly **^^Gardeners of Nurgle^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, while the target is wholly within 12&quot; of any friendly **Feculent Gnarlmaws**, ward rolls cannot be made for enemy units in combat with the target.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Lore of the Awakened Realms" id="0c5d-122d-1358-ed4d" hidden="false" publicationId="9ed1-cf74-eb97-dee2">
      <selectionEntries>
        <selectionEntry name="Elemental Push" id="02bf-a11c-79b2-0361" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e8f4-5b4b-96df-25a6" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="ed5d-d2ac-cb2e-9d54" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="ed5d-d2ac-cb2e-9d54" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Elemental Push" id="3342-08e9-3f0e-8618" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Lumineth Realm‑lords Wizard^^** to cast this spell, pick a visible friendly **^^Lumineth Realm-lords^^** unit wholly within 12&quot; of them that was not set up this turn to be the target, then make a casting roll of 2D6. Subtract 1 from the roll if the target is in combat.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">The target can move up to 5&quot;. It can pass through the combat ranges of enemy units but cannot end that move in combat.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Realmshield" id="d858-66d9-9536-e0d0" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5332-afc4-fa70-e80f" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="b056-13f3-55f9-b87e" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
