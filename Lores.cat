          <constraints>
            <constraint id="da40-52bc-a9d4-feab" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="3b58-58f0-f3a5-3d89" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
