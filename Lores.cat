    <selectionEntryGroup name="Spell Lore: Legion of the First Prince" id="b060-dbbf-c789-3c61" hidden="false" publicationId="6357-5d77-a2b2-f86b">
      <selectionEntries>
        <selectionEntry name="Shroud in Darkness" id="1f9f-df92-739a-600f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="936c-cd10-a1ba-7485" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="3ffb-cea6-9998-d978" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="3ffb-cea6-9998-d978" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Shroud in Darkness" id="6ee0-26b7-5580-9f17" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Legion of the First Prince Wizard^^** to cast this spell, pick a visible friendly **^^Legion of the First Prince^^** unit that is not in combat and is wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">The target can move D6&quot;. It cannot end that move in combat. In addition, until the start of your next turn, the target is not visible to enemy units while they are more than 12&quot; away.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Dark Cantrip" id="4f3d-9997-2841-9cef" hidden="false" import="true" type="upgrade">
          <constraints>
