          <profiles>
            <profile name="Filth-crust" id="f4dd-d5cd-fbbb-aa9" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Skaven Priest^^** to chant this prayer, pick a visible friendly **^^Skaven Infantry^^** unit wholly within 13&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Add 1 to wound rolls for the target&apos;s combat attacks until the start of your next turn. In addition, if the chanting roll was 8+, the target&apos;s melee weapons have **Crit (Mortal)** until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bile-torrent" id="c372-c6f1-c401-3405" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4b39-6c7d-c30c-1d6d" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="b171-ee62-03c9-de31" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
