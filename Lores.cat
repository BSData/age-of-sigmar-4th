        <selectionEntry name="The Green God&apos;s Hammer" id="3932-1079-d393-0fb7" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9b27-558a-b9d0-af39" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="b426-0ae4-77c9-ebc4" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="9b27-558a-b9d0-af39" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="The Green God&apos;s Hammer" id="5a76-6c28-4ed3-f6ab" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Zoggrok&apos;s Ironmongerz Wizard^^** to cast this spell, pick a visible friendly **^^Zoggrok&apos;s Ironmongerz Infantry^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, add 1 to the number of dice rolled when making charge rolls for the target, to a maximum of 3.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
