    <selectionEntryGroup name="Prayer Lore: Soulpod Guardians" id="59bf-a41f-8c31-c025" hidden="false" publicationId="61ee-fae0-f1da-2591">
      <selectionEntries>
        <selectionEntry name="Song of Vengeance" id="0ee3-04a3-fea3-b3bd" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7266-df3a-9f9b-c46e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d7e3-6e01-7724-d71e" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="d7e3-6e01-7724-d71e" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Song of Vengeance" id="e64b-c4d6-0f67-e520" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Soulpod Guardians Priest^^** to chant this prayer, pick a visible friendly **^^Soulpod Guardians^^** that is wholly within 12&quot; of them and not in combat or that is wholly within 12&quot; of your **Soulpod Grove** to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 8+, you can pick another eligible unit to be a second target. The target(s) can move up to 5&quot; and can end that move in combat.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Spell Lore: Soulpod Guardians" id="cdc4-8f41-f675-81a1" hidden="false" publicationId="61ee-fae0-f1da-2591">
      <selectionEntries>
        <selectionEntry name="Cradling Vines" id="ddea-1256-f426-362a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0bab-e958-2023-94cb" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
