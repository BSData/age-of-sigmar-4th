    <selectionEntryGroup name="Lore of the Storm" id="b054-bd72-a5bf-1319" hidden="false" publicationId="43cd-e9ef-5d4d-87c4">
      <selectionEntries>
        <selectionEntry name="Lightning Blast" id="dbe3-971c-d2ac-e4c8" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="70b1-b557-c998-ae95" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="9f3c-f5d6-59ea-6328" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="70b1-b557-c998-ae95" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Lightning Blast" id="b918-ea95-5c6e-1dd5" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Stormcast Eternals Wizard^^** to cast this spell, then pick the closest visible enemy unit to them that has not been picked to be the target of this ability this turn to be the target. If 2 or more visible enemy units are tied to be the closest, you can pick which is the target. Then, make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflict D3 mortal damage on the target.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Starfall" id="87d1-0549-f5ed-810f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="984c-be0b-c850-b8c9" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="367c-ad8b-9a24-c01e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="984c-be0b-c850-b8c9" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
