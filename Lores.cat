              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Deranged Transformation" id="720d-ef7b-fc5b-2dd9" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^New Summercourt Wizard^^** to cast this spell, pick a visible friendly **^^New Summercourt Infantry^^** or **^^Cavalry^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn:
• Add 2&quot; to the target&apos;s Move characteristic.
• Add 1 to wound rolls for the target&apos;s combat attacks.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Miasma of Madness" id="1180-eeb6-4c76-86d4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d648-cc33-410b-5f92" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="d0b6-9a6d-e549-02d6" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="d648-cc33-410b-5f92" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Miasma of Madness" id="f4bb-b1a2-0d0b-a56a" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^New Summercourt Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, for each unmodified hit roll of 1 for a combat attack made by the target, inflict 1 mortal damage on the target after the **^^Fight^^** ability has been resolved.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Manifestation Lore: New Summercourt" id="4fa1-4ee4-80dd-03ee" hidden="false" publicationId="6281-1a88-8f4-946">
