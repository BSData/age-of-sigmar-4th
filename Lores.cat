            <constraint id="70ce-40e5-af85-8083" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="de9a-271a-a996-cd52" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
