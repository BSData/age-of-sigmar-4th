          </modifiers>
          <profiles>
            <profile name="Hand of Demise" id="f799-d23d-8537-1e88" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Lethis Wizard^^** to cast this spell, pick a visible friendly **^^Lethis^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Add 1 to the Attacks characteristic of the target&apos;s melee weapons until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amethyst Haze" id="81a3-d1c2-f9ed-426e" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9114-79a7-7206-77d3" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
