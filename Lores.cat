          </modifiers>
          <profiles>
            <profile name="Shield of Fate" id="4312-c1f4-bd9-b99f" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Disciples of Tzeentch Wizard^^** to cast this spell, pick a visible friendly **^^Disciples of Tzeentch^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn:
• The target has **^^Ward (5+)^^**.
• Subtract 1 from hit rolls for attacks that target that unit.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Wyrdflame Haze" id="cc15-b786-7bb2-1107" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ac74-31bf-75e9-4d46" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4d44-d795-72ba-7be9" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
