      </modifiers>
      <selectionEntries>
        <selectionEntry name="Itchy Nuisance" id="1c72-cdcf-3417-6a15" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b949-1fa1-1742-2577" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="6dae-d4ac-8927-1c04" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="b949-1fa1-1742-2577" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Itchy Nuisance" id="6a95-f88d-c5ac-f714" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Gloomspite Gitz Wizard^^** to cast this spell, pick an objective within 18&quot; of this unit to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Until the start of your next turn, subtract 1 from wound rolls for attacks made by enemy units while they are contesting the target objective.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Loonshrine Glow" id="40ef-33d6-bb29-41dc" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3c78-8d40-153c-5388" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="92c6-c099-ed76-25e5" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="3c78-8d40-153c-5388" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Loonshrine Glow" id="b001-ea9f-eba7-d549" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Rallying</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Gloomspite Gitz Wizard^^** to cast this spell, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">For the rest of the turn, if a friendly **Bad Moon Loonshrine** uses the &apos;Moonclan Lairs&apos; ability, you can set up the replacement unit wholly within 6&quot; of this unit and more than 3&quot; from all enemy units instead of wholly within 12&quot; of that **Bad Moon Loonshrine**.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Puffballoons" id="f043-d846-2f29-f1a9" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3b28-99de-8c32-5a46" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="0c3c-5431-a460-7ae3" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
