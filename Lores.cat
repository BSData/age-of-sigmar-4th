            <constraint id="b879-8572-fefd-7ba4" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="9c87-503a-38c4-c5ea" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
