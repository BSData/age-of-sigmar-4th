              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Manifestations of Murder" id="5d51-5146-6200-5ced" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Zainthar Kai Wizard^^** to cast this spell, pick 1 of the friendly **^^Manifestations^^** below that is not on the battlefield, then make a casting roll of 2D6.
• **Bloodwrack Viper**
• **Bladewind**
• **Heart of Fury**</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">If you picked a **Bloodwrack Viper** or **Bladewind**, set it up wholly within 12&quot; of the caster, visible to them and more than 9&quot; from all enemy units. If you picked a **Heart of Fury**, set it up wholly within 18&quot; of the caster and visible to them.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Summon^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
