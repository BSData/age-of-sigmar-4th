        <selectionEntry name="Summon Geminids of Uhl-Gysh" id="3008-bafb-852b-b69f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="14d6-07f5-a749-496f" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
