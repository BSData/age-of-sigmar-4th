                <condition childId="78a1-f6c2-71b8-270a" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry name="Gitspeed" id="efe5-64ef-c59c-585b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4511-f91b-a8a3-ce55" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="0b07-7868-1a5a-f655" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="4511-f91b-a8a3-ce55" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Gitspeed" id="221e-54a2-3619-5748" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Gloomspite Gitz Wizard^^** to cast this spell, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn, add 2&quot; to the Move characteristic of friendly non-**^^Troggoth Gloomspite Gitz^^** units while they are wholly within 12&quot; of this unit.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bright Fright" id="6043-9f44-b4af-8920" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f8aa-00c3-0ad1-b55e" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="ce65-b84f-f78d-2a17" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="f8aa-00c3-0ad1-b55e" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Bright Fright" id="0583-216a-7f53-0693" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Gloomspite Gitz Wizard^^** to cast this spell, pick up to 3 friendly visible **^^Gloomspite Gitz^^** units wholly within 12&quot; of them to be the targets, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Each target can immediately use a **^^Retreat^^** ability as if it was your movement phase. No mortal damage is inflicted on the targets by those **^^Retreat^^** abilities.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gaze of Glareface" id="38be-0d0c-bff4-d65e" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8edc-7896-e5ca-365d" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="9bc8-bf0d-ea5b-c3d0" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="8edc-7896-e5ca-365d" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Gaze of Glareface" id="0775-dbb4-b97c-c59b" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Gloomspite Gitz^^** Wizard to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Until the start of your next turn:
• The target cannot use **^^Run^^** abilities.
• Halve the Range characteristic of the target&apos;s ranged weapons.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Lore of Necrotheurgy" id="98e6-fc4b-ed37-d293" hidden="true" publicationId="f894-7929-f79a-a269">
