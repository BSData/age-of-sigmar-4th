    <selectionEntryGroup name="Prayer Lore: Lethis" id="b61c-5b55-1d99-a91f" hidden="false" publicationId="dadd-06f0-3f38-c6f3">
      <selectionEntries>
        <selectionEntry name="The Raven&apos;s Protection" id="07de-e607-a51f-bb85" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bb71-7e6a-3390-fa09" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d1f0-c89c-09f0-3509" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="d1f0-c89c-09f0-3509" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="The Raven&apos;s Protection" id="41e8-5675-2ca4-d944" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Lethis Priest^^** to chant this prayer, pick a visible friendly non-**^^War Machine Lethis^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 10+, you can pick another eligible unit to be a second target. Until the start of your next turn, each target has **^^Ward (5+)^^**.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Raven&apos;s Blessing" id="1a2e-822f-9c75-7ed9" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f1b2-0a66-3d47-8cf6" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5605-3952-9e4f-8718" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="5605-3952-9e4f-8718" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="The Raven&apos;s Blessing" id="504f-7642-ac33-936e" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Lethis Priest^^** to chant this prayer, pick a visible friendly **^^Lethis^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Roll a D3. On a chanting roll of 10+, use a value of 3 instead of rolling.
• If the target is damaged, **Heal (X)** the target, where **X** is equal to the roll.
• If the target is not damaged, return a number of slain models to it with a combined Health characteristic of up to **X**, where **X** is equal to the roll.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Raven&apos;s Price" id="da2c-b5d8-ab84-d3f6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5acd-6125-d501-dcc7" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="9d78-b27f-aa87-0c0a" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="9d78-b27f-aa87-0c0a" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="The Raven&apos;s Price" id="4113-5a82-b27a-3bfa" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Lethis Priest^^** to chant this prayer, pick a visible friendly **^^Lethis^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 8+, you can pick another eligible unit to be a second target. Allocate D3 damage points to each target (ward rolls cannot be made for those damage points), then until the start of your next turn, add 2 to charge rolls for each target.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
