              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" id="52ca-1e11-2fd5-9799" hidden="false" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" id="9800-7458-2809-747b" hidden="false" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" id="a63e-af00-f918-fff2" hidden="false" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Soulblight Gravelords Wizard^^** to cast this spell, pick a visible enemy unit within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" id="12c5-6e32-229f-fe27" hidden="false" typeId="1cb9-a-1345-907f">For the rest of the turn, subtract 1 from the Damage characteristic of the target&apos;s melee weapons.</characteristic>
                <characteristic name="Keywords" id="9195-631c-ee43-c9a3" hidden="false" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
