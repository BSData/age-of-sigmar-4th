    <selectionEntryGroup name="Spell Lore: The Eternal Nightmare" id="1215-5ab1-637f-f5fd" hidden="false" publicationId="67f7-aa7f-294f-880d">
      <selectionEntries>
        <selectionEntry name="Divine Terror" id="9ad1-0059-9be4-72fe" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3036-d426-5d03-d49a" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
