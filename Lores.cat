        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry name="Rock Bottom" id="9edb-a935-0862-990b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="66a5-3b77-6e3c-0103" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="903b-85f2-2323-237c" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="66a5-3b77-6e3c-0103" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Rock Bottom" id="f182-c3ff-e45b-7576" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sons of Behemat Priest^^** to chant this prayer, pick a visible friendly **^^Sons of Behemat^^** unit wholly within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 6+, you can pick another eligible unit to be a second target. Until the start of your next turn:
• Ignore the effects of the &apos;Battle Damaged&apos; ability on each target.
• Each target has **^^Ward (6+)^^**.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Terrible Toes" id="82b8-6a63-e254-f7d3" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ac4d-7f54-4a16-cd86" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="003b-7572-0a78-579a" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="ac4d-7f54-4a16-cd86" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="The Terrible Toes" id="ede1-eb32-af01-d1c0" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sons of Behemat Priest^^** to chant this prayer, pick a visible enemy unit within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Roll a dice for each model in the target unit. If the chanting roll was 8+, add 1 to the roll. For each 6+, inflict 1 mortal damage on the target. Then, if any enemy models are slain by this ability, halve the target&apos;s Move characteristic until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vocal Tectonics" id="e241-a12c-439e-d140" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7238-7101-ca18-1bcc" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="355c-070b-7017-b26e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="7238-7101-ca18-1bcc" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Vocal Tectonics" id="8316-9ff7-5e3d-278f" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sons of Behemat Priest^^** to chant this prayer, pick a visible enemy unit within 12&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 10+, you can pick another eligible unit to be a second target. Until the start of your next turn, each target has **^^Strike-last^^**.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Lore of Behemat" id="0794-857a-6dd8-5da4" hidden="false" publicationId="b765-4747-cddc-385e">
      <selectionEntries>
        <selectionEntry name="Energy Surge" id="d691-c47e-e37e-43d4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="589d-23a2-14cb-7d0f" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="8ab7-e1fb-f6d7-f759" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="589d-23a2-14cb-7d0f" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Energy Surge" id="8479-8a35-b45c-9b81" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Sons of Behemat Wizard^^** to cast this spell, pick a visible friendly **^^Sons of Behemat Monster^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">If the target is **^^Big^^**, add 1 to rampage rolls for it until the start of your next turn. If the target is **^^Little^^**, until the start of your next turn, it can use **^^Charge^^** abilities even if it used a **^^Run^^** ability in the same turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pipsqueak Curse" id="c406-9574-2e30-c03b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7b6f-49d5-abe1-1378" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="625e-03d0-2b5d-5f28" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="7b6f-49d5-abe1-1378" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Pipsqueak Curse" id="ae6a-0562-67bd-1510" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Sons of Behemat Wizard^^** to cast this spell, pick a visible enemy unit within 18&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Subtract 1 from wound rolls for the target&apos;s attacks until the start of your next turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Thornfang&apos;s Wrath" id="4630-ece0-ea02-a468" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bbe0-7d10-1c3f-83a0" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="cbfc-552c-23ab-95f1" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="bbe0-7d10-1c3f-83a0" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Thornfang&apos;s Wrath" id="337a-a5f4-1b68-3a6e" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Your Hero Phase</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Pick a friendly **^^Sons of Behemat Wizard^^** to cast this spell, pick a visible friendly **^^Sons of Behemat Monster^^** unit wholly within 12&quot; of them to be the target, then make a casting roll of 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">The target&apos;s melee weapons have **Crit (Mortal)** for the rest of the turn.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Prayers of the World Titan" id="c486-9b11-e6bd-8f6e" hidden="false" publicationId="b765-4747-cddc-385e">
      <selectionEntries>
        <selectionEntry name="World Titan&apos;s Stride" id="f28c-d51b-1ba7-8daf" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="85b8-3fc1-db7b-e058" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="c29b-f957-9219-823d" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="85b8-3fc1-db7b-e058" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="World Titan&apos;s Stride" id="7282-c69b-1df6-0f49" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sons of Behemat Priest^^** to chant this prayer, pick a visible friendly **^^Sons of Behemat Monster^^** unit wholly within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">For the rest of the turn, add 3&quot; to the target&apos;s Move characteristic and models in the target unit can pass across enemy models and terrain features as if it had **^^Fly^^**. In addition, if the chanting roll was 6+, for the rest of the turn, each time the target uses the &apos;Normal Move&apos; or &apos;Run&apos; ability, after that ability has been resolved, inflict D3 mortal damage on each enemy unit the target passed across as part of that move.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**, **^^Unlimited^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Might of the Earth" id="eb73-a500-0064-62bd" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e815-6ffb-45b2-5a3c" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="63a7-1fca-94a7-ac6a" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="e815-6ffb-45b2-5a3c" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Might of the Earth" id="16d8-e1b9-0213-da64" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Rallying</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sons of Behemat Priest^^** to chant this prayer, pick each friendly **^^Sons of Behemat^^** unit on the battlefield to be the targets, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">**Heal (D3)** each target. If the chanting roll was 8+, **Heal (3)** each target instead.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Behemat&apos;s Vengeance" id="7b12-1418-5fe8-4f9f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e825-f646-0269-abf9" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="f411-7c5e-da38-fcd7" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="e825-f646-0269-abf9" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Behemat&apos;s Vengeance" id="77ef-1d5a-88d6-3953" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Your Hero Phase</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Pick a friendly **^^Sons of Behemat Priest^^** to chant this prayer, pick a visible friendly **^^Sons of Behemat Monster^^** unit wholly within 18&quot; of them to be the target, then make a chanting roll of D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">If the chanting roll was 8+, you can pick another eligible unit to be a second target. Add 1 to the Attacks characteristic of each target&apos;s melee weapons for the rest of the turn.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Prayer^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
