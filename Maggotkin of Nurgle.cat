    <selectionEntryGroup name="Battle Formations: Maggotkin of Nurgle" id="4d17-18ad-7183-f4e7" flatten="true" hidden="false">
      <constraints>
        <constraint id="a0b7-5f56-e642-b47c" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Affliction Cyst" id="2988-a12d-acab-ca65" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="aada-ba6a-9a6e-c46" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Filth-laden Daemonic Blooms" id="7469-2877-3da7-2d5f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Each time you make a run roll for a friendly non-**^^Monster Maggotkin of Nurgle Daemon^^** unit, you can change that roll to a 4.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tallyband of Nurgle" id="da47-dbe7-6c0d-6cd7" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cd34-5b2f-1a8c-22df" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Plague Progenitor" id="8824-6855-6594-fb52" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle (Army), Deployment Phase</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick an enemy unit on the battlefield to be the **plague progenitor** for the rest of the battle. You cannot pick a **^^Manifestation^^** or terrain feature.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll 2D3. On a 6, or if the roll equals or exceeds the **plague progenitor**&apos;s Health characteristic, it has the **^^Diseased^^** keyword.
In the first battle round, if an ability would heal or return any slain models to a **^^Diseased^^** **plague progenitor**, that ability does not
heal any damage points or return any slain models to it.
Each time the **plague progenitor** is picked to be the target of the &apos;Spread&apos; effect of the &apos;Blessed by the Plaguefather&apos; ability, inflict D3 mortal damage on each other enemy unit within its combat range, excluding **^^Manifestations^^** and terrain features, in addition to the effect of that ability.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Nurgle&apos;s Menagerie" id="9439-707a-2faa-81f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dff2-304b-e247-d3b8" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Denizens of the Garden" id="e0f8-2573-5a85-5af6" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
